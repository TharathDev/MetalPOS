<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PosApp.ViewModels"
        xmlns:models="using:PosApp.Models"
        xmlns:conv="using:PosApp.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="820"
        x:Class="PosApp.Views.MainWindow"
        x:DataType="vm:MaterialSelectionViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1200" Height="820"
        MinWidth="1040" MinHeight="680"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource BodyFont}"
        Title="METALS_POS - Inventory Manager">

    <Design.DataContext>
        <vm:MaterialSelectionViewModel />
    </Design.DataContext>

    <!-- ================= Resources ================= -->
    <Window.Resources>
        <!-- ===== Classical design tokens =====
             Warm-gray ground, gold accent, ink-warm text. Ported from the
             imported "Classical" design system (Metals POS.dc.html). -->
        <SolidColorBrush x:Key="Bg" Color="#F3F2F2" />
        <SolidColorBrush x:Key="Surface" Color="#EAE9E9" />
        <SolidColorBrush x:Key="Accent" Color="#B68235" />
        <SolidColorBrush x:Key="AccentDark" Color="#7D5411" />
        <SolidColorBrush x:Key="TextPrimary" Color="#201F1D" />
        <SolidColorBrush x:Key="TextMuted" Color="#7C7A78" />
        <SolidColorBrush x:Key="TextFaint" Color="#9A9895" />
        <SolidColorBrush x:Key="HairLine" Color="#D2D1CF" />
        <SolidColorBrush x:Key="Danger" Color="#B23B2E" />
        <SolidColorBrush x:Key="PeachTile" Color="#FFF3E4" />
        <SolidColorBrush x:Key="BlueTile" Color="#EAE9E9" />
        <SolidColorBrush x:Key="ChipBg" Color="#EAE9E9" />
        <SolidColorBrush x:Key="LavenderPill" Color="#FFF3E4" />
        <SolidColorBrush x:Key="LavenderText" Color="#7D5411" />

        <!-- Selected dimension row highlight (compares ListBoxItem.IsSelected to True) -->
        <conv:EqualityToBrushConverter x:Key="RowBg" TrueBrush="#FFF3E4" FalseBrush="Transparent" />
        <conv:EqualityToBrushConverter x:Key="RowBorder" TrueBrush="#B68235" FalseBrush="#D2D1CF" />

        <!-- ===== Input chrome overrides =====
             The stock Fluent theme fills text inputs with a grey wash and uses a
             thick blue focus underline. These keep inputs flat white with square
             corners and an accent focus border, matching the rest of the UI. -->
        <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>

        <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" Opacity="0" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" Opacity="0" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" Opacity="0" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#EAE9E9" />

        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D2D1CF" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#9A9895" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#B68235" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#D2D1CF" />

        <SolidColorBrush x:Key="TextControlForeground" Color="#201F1D" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#201F1D" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#201F1D" />

        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#9A9895" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#9A9895" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#B0AEAB" />

        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#B68235" />
        <!-- Fluent thickens the bottom edge on focus; keep it an even 1px box. -->
        <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

        <!-- ComboBox chrome -->
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" Opacity="0" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#201F1D" Opacity="0.06" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#201F1D" Opacity="0.1" />
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFF" Opacity="0" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#EAE9E9" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D2D1CF" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#9A9895" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#B68235" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#B68235" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#201F1D" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#EAE9E9" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#D2D1CF" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#FFF3E4" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FFE3BF" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#201F1D" />
    </Window.Resources>

    <!-- ================= Styles ================= -->
    <Window.Styles>
        <!-- Classical drops monospace: kickers/labels become tracked uppercase serif. -->
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="LetterSpacing" Value="0.8" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- Line-icon defaults -->
        <Style Selector="Path.icon">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
            <!-- A Shape with an explicit Width/Height still defaults to Stretch
                 alignment, which is not reliably centered inside a fixed-size
                 container (Border icon boxes, pills, etc.) - pin it explicitly so
                 every icon centers the same way everywhere it's used. -->
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Sidebar nav buttons -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#12000000" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Foreground" Value="{StaticResource AccentDark}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PeachTile}" />
        </Style>

        <!-- Accent (primary) buttons — classical: outlined gold, not a solid block. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- Pin the chrome for every state so no theme variant can recolor it. -->
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextBlock.Foreground" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22B68235" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3AB68235" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#D8C6A6" />
        </Style>

        <!-- ===== Smooth interactions: fade hover colors, subtle press + card lift ===== -->
        <!-- All buttons fade their background/border on hover instead of snapping. -->
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.17" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.17" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <!-- Gentle press feedback on the primary/interactive buttons. -->
        <Style Selector="Button.primary, Button.pill, Button.ghost, Button.rowAdd, Button.iconBtn, Button.quickAction">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.11" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pressed, Button.pill:pressed, Button.ghost:pressed, Button.rowAdd:pressed, Button.iconBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>

        <!-- Header pills -->
        <Style Selector="Button.pill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#12000000" />
        </Style>

        <!-- Category filter pills (rounded-full) shown above the catalog product grid -->
        <Style Selector="Button.categoryPill">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="Button.categoryPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#12000000" />
        </Style>
        <Style Selector="Button.categoryPill.active">
            <Setter Property="Foreground" Value="{StaticResource AccentDark}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.categoryPill.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PeachTile}" />
        </Style>
        <Style Selector="Button.categoryPillDashed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="Button.categoryPillDashed:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#12000000" />
        </Style>

        <!-- Category card buttons -->
        <Style Selector="Button.categoryCard">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="MinHeight" Value="228" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.categoryCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFBF3" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <!-- Cards gently lift on hover for a smooth, tactile feel. -->
        <Style Selector="Button.categoryCard">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.categoryCard:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-3px)" />
        </Style>

        <!-- Catalog product card: same card look as categoryCard but content-sized
             (no MinHeight / no fixed Height) so every tile in the grid ends up the
             exact same height without a big dead gap. -->
        <Style Selector="Button.productCard">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="16" />
            <!-- A definite height keeps every tile identical AND gives the grid a
                 deterministic total height so the page scrolls all the way down. -->
            <Setter Property="Height" Value="172" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.productCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFBF3" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="Button.productCard:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-3px)" />
        </Style>

        <!-- Quick-action rows -->
        <Style Selector="Button.quickAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.quickAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#12000000" />
        </Style>

        <!-- Transparent button (icon buttons, tab click surface, scrim) -->
        <Style Selector="Button.bare">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <!-- Translucent overlay so it reads on white and on colored (tab) backgrounds. -->
            <Setter Property="Background" Value="#14000000" />
        </Style>

        <Style Selector="Button.settingsTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.settingsTab.active">
            <Setter Property="Background" Value="{StaticResource PeachTile}" />
            <Setter Property="Foreground" Value="{StaticResource AccentDark}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- Scrim behind the modal (fades in/out) -->
        <Style Selector="Button.scrim">
            <Setter Property="Background" Value="#4D1F2937" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.scrim.open">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.scrim:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4D1F2937" />
        </Style>

        <!-- Drawer slides in from the right -->
        <Style Selector="Border.drawer">
            <Setter Property="RenderTransform" Value="translateX(520px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.drawer.open">
            <Setter Property="RenderTransform" Value="translateX(0)" />
        </Style>

        <!-- Small per-row ADD TO CART button -->
        <Style Selector="Button.rowAdd">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style Selector="Button.rowAdd:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22B68235" />
        </Style>

        <!-- Compact quantity stepper shown once a row is in the cart. Kept visually
             light (outlined, not a solid block) so it doesn't outweigh the row text. -->
        <Style Selector="Button.qtyStep">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.qtyStep:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PeachTile}" />
        </Style>
        <Style Selector="Button.qtyStep:disabled">
            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        </Style>

        <!-- Dimension ListBox: strip default selection chrome so our row Border shows through -->
        <Style Selector="ListBox.dims">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.dims ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBox.dims ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.dims ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Technical documentation links -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Form field label -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Text inputs / combos: flat white, square, accent focus ring -->
        <Style Selector="TextBox.field">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Style the template border directly so the chrome can't be re-filled
             by theme-variant resources. -->
        <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#9A9895" />
        </Style>
        <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="TextBox.field:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style Selector="ComboBox.field">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Secondary (ghost) button -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#12000000" />
        </Style>

        <!-- Secondary (outlined) button — used for Sign out etc. -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#12000000" />
        </Style>

        <!-- Small icon action button (edit/delete rows) -->
        <Style Selector="Button.iconBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#12000000" />
        </Style>

        <!-- Segmented period toggle (Daily / Weekly / Monthly) -->
        <Style Selector="Button.segbtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.segbtn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.segbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#12000000" />
        </Style>
        <Style Selector="Button.segbtn.on">
            <Setter Property="Foreground" Value="{StaticResource AccentDark}" />
        </Style>
        <Style Selector="Button.segbtn.on /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PeachTile}" />
        </Style>
        <Style Selector="Button.segbtn.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PeachTile}" />
        </Style>

        <!-- Report summary stat card -->
        <Style Selector="Border.statCard">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="BoxShadow" Value="0 1 2 0 #24201F1D" />
        </Style>

        <!-- Table header cell -->
        <Style Selector="TextBlock.th">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>

        <!-- Search box: the whole pill highlights in accent on focus. The inner
             TextBox's own border/underline is fully suppressed so it doesn't draw
             a second box inside the pill. -->
        <Style Selector="Border.searchBox">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.searchBox:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="TextBox.searchInput /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.searchInput:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <!-- ================= Layout ================= -->
    <Grid ColumnDefinitions="248,*">

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="Transparent" BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,20">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="6,0,0,26">
                    <TextBlock Classes="mono" Text="METALS_POS" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Classes="mono" Text="INVENTORY MANAGER" FontSize="11"
                               Foreground="{StaticResource TextFaint}" />
                </StackPanel>

                <!-- Bottom block: live-inventory status tag (matches design mock) -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="3"
                            Padding="10,6" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon" Width="13" Height="13" Stroke="{StaticResource Accent}"
                                  Data="M13 3 L6 14 H11 L10 21 L18 9 H13 Z" />
                            <TextBlock Text="{Binding LiveInventoryText}" FontSize="11"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Nav items -->
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <Button Classes="nav" Classes.active="{Binding IsInventorySection}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Inventory">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Width="19" Height="19"
                                  Data="M4 4 H20 V20 H4 Z M4 9 H20 M9 4 V9" />
                            <TextBlock Text="{Binding NavInventoryText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsStockSection}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Stock">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Width="19" Height="19"
                                  Data="M12 3 L20 7 L12 11 L4 7 Z M4 12 L12 16 L20 12 M4 17 L12 21 L20 17" />
                            <TextBlock Text="{Binding NavStockText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsOrdersNavActive}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Orders">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Width="19" Height="19"
                                  Data="M3 4 H5 L7.2 15 H18 L20 7 H6 M8.5 19 a1.2 1.2 0 1 0 0.01 0 M17 19 a1.2 1.2 0 1 0 0.01 0" />
                            <TextBlock Text="{Binding NavOrdersText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsReportsSection}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Reports">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Width="19" Height="19"
                                  Data="M4 20 H21 M6 20 V12 M11 20 V5 M16 20 V9" />
                            <TextBlock Text="{Binding NavReportsText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Right of sidebar ===== -->
        <DockPanel Grid.Column="1">

            <!-- Top bar -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,0,1"
                    Padding="24,14">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <!-- Search -->
                    <Border Grid.Column="0" Classes="searchBox" Background="Transparent"
                            BorderBrush="{StaticResource HairLine}"
                            BorderThickness="1" CornerRadius="4" Padding="12,0" MaxWidth="620"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*" Height="42">
                            <Path Grid.Column="0" Classes="icon" Width="17" Height="17" Margin="2,0,10,0"
                                  Data="M10 4 a6 6 0 1 0 0.01 0 M15 15 L20 20" />
                            <TextBox Grid.Column="1" Classes="searchInput" Text="{Binding SearchText}"
                                     PlaceholderText="{Binding SearchMaterialsPlaceholder}"
                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" FontSize="14" Padding="0" />
                        </Grid>
                    </Border>

                    <!-- Bell -->
                    <Panel Grid.Column="1" Margin="22,0,20,0" VerticalAlignment="Center" Width="24" Height="24">
                        <Path Classes="icon" Width="22" Height="22"
                              Data="M12 4 C9 4 8 6 8 9 C8 13 6 15 6 15 H18 C18 15 16 13 16 9 C16 6 15 4 12 4 Z M10 18 a2 2 0 0 0 4 0" />
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Stroke="{StaticResource Bg}" StrokeThickness="1.2"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" />
                    </Panel>

                    <!-- User / settings entry point -->
                    <Button Grid.Column="2" Classes="bare" Padding="0"
                            Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource ChipBg}">
                                <Path Classes="icon" Width="18" Height="18"
                                      Data="M12 8 a3 3 0 1 0 0.01 0 M6 19 a6 6 0 0 1 12 0" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding AdminUserText}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Classes="mono" Text="WAREHOUSE A · SETTINGS" FontSize="10"
                                           Foreground="{StaticResource TextFaint}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Content: main + optional wide-screen specs panel -->
            <Grid ColumnDefinitions="*,Auto">

                <!-- Main content -->
                <ScrollViewer Grid.Column="0" Padding="28,24" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Header row -->
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Classes="h1" Text="{Binding SectionTitle}" />
                                <TextBlock Text="{Binding SectionSubtitle}"
                                           FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                           MaxWidth="460" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                                <Button Classes="pill" Background="{StaticResource LavenderPill}"
                                        Foreground="{StaticResource LavenderText}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource LavenderText}"
                                              Data="M13 3 L6 14 H11 L10 21 L18 9 H13 Z" />
                                        <TextBlock Classes="mono" Text="{Binding LiveInventoryText}" FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ============ INVENTORY SECTION ============ -->
                        <StackPanel IsVisible="{Binding IsInventorySection}" Margin="0,24,0,0" Spacing="18">

                            <!-- ===== Category filter row: small pills, not big tiles ===== -->
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CategoryInfo">
                                        <Grid Margin="0,0,10,10">
                                            <!-- Category filter pill: toggles the product grid below -->
                                            <Button Classes="categoryPill" Classes.active="{Binding IsFilterActive}"
                                                    IsVisible="{Binding !IsCustom}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).ToggleCategoryFilterCommand}"
                                                    CommandParameter="{Binding Name}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Path Classes="icon" Width="15" Height="15"
                                                          Data="M12 3 L20 7 L12 11 L4 7 Z M4 12 L12 16 L20 12 M4 17 L12 21 L20 17" />
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SkuLabel}" FontSize="11" Opacity="0.7"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Dashed "+ Add Custom Object" pill -->
                                            <Button Classes="categoryPillDashed" IsVisible="{Binding IsCustom}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).AddCustomCategoryCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Classes="icon" Width="14" Height="14"
                                                          Data="M12 5 V19 M5 12 H19" />
                                                    <TextBlock Text="Add Custom Object" FontSize="13" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ===== Flat product grid: every SKU, filtered by pill + search ===== -->
                            <TextBlock Text="{Binding CatalogSummaryText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMuted}" />
                            <ItemsControl ItemsSource="{Binding CatalogItems}" Margin="-8,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding CategoryColumns}" Rows="0"
                                                     VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Product">
                                        <Button Classes="productCard" Margin="8"
                                                Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).OpenProductQuickAddCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid RowDefinitions="Auto,*,Auto">
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                                    <Border Width="40" Height="40" CornerRadius="7"
                                                            Background="{StaticResource PeachTile}">
                                                        <Path Classes="icon" Width="19" Height="19"
                                                              Stroke="{StaticResource Accent}"
                                                              Data="M12 3 L20 7 L12 11 L4 7 Z M4 12 L12 16 L20 12 M4 17 L12 21 L20 17" />
                                                    </Border>
                                                    <Border Grid.Column="2" VerticalAlignment="Top"
                                                            Background="{StaticResource ChipBg}" CornerRadius="6"
                                                            Padding="8,4">
                                                        <TextBlock Classes="mono" FontSize="10"
                                                                   Text="{Binding Category}"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Row="1" Spacing="2" Margin="0,12,0,0"
                                                            VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Name}" FontSize="15"
                                                               FontFamily="{StaticResource HeadingFont}"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="{Binding DimensionLabel}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextMuted}" />
                                                </StackPanel>
                                                <Border Grid.Row="2" BorderBrush="{StaticResource HairLine}"
                                                        BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding PriceLabel}"
                                                                   FontSize="16" FontWeight="Bold"
                                                                   FontFamily="{StaticResource HeadingFont}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding LocalizedStockDisplay}"
                                                                   FontSize="12" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ============ STOCK MANAGEMENT SECTION ============ -->
                        <StackPanel IsVisible="{Binding IsStockSection}" Margin="0,22,0,0" Spacing="14">

                            <!-- Toolbar: status + add button -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="{Binding StockStatus}" FontSize="13"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="2,0,12,0" />
                                <Button Grid.Column="1" Classes="primary" Padding="14,10"
                                        Command="{Binding OpenAddProductCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource Accent}"
                                              Data="M12 5 V19 M5 12 H19" />
                                        <TextBlock Classes="mono" Text="{Binding AddItemText}" FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Stock table -->
                            <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                    CornerRadius="7" Padding="0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,90,70,80,84"
                                          Background="#EDECEB" Height="40">
                                        <TextBlock Classes="th" Text="{Binding StockItemText}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <TextBlock Grid.Column="1" Classes="th" Text="{Binding PriceText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="th" Text="{Binding StockQtyText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Classes="th" Text="{Binding SkuText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Classes="th" Text="{Binding ActionsText}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" />
                                    <ItemsControl ItemsSource="{Binding StockItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:Product">
                                                    <Border BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,0,1"
                                                            Padding="14,10">
                                                        <Grid ColumnDefinitions="*,90,70,80,84" VerticalAlignment="Center">
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimary}" />
                                                                <TextBlock Text="{Binding CategoryDimensionLine}"
                                                                           FontSize="12"
                                                                           Foreground="{StaticResource TextMuted}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding PriceLabel}"
                                                                       FontSize="13" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding LocalizedStockDisplay}"
                                                                       FontSize="13" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding SkuDisplay}"
                                                                       FontSize="11" VerticalAlignment="Center"
                                                                       Classes="mono"
                                                                       Foreground="{StaticResource TextFaint}" />
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                                                        VerticalAlignment="Center">
                                                                <Button Classes="iconBtn"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).EditProductRowCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Path Classes="icon" Width="15" Height="15"
                                                                          Data="M4 20 L4 16 L15 5 L19 9 L8 20 Z M13 7 L17 11" />
                                                                </Button>
                                                                <Button Classes="iconBtn"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).DeleteProductRowCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Path Classes="icon" Width="15" Height="15"
                                                                          Stroke="{StaticResource Danger}"
                                                                          Data="M5 7 H19 M9 7 V5 H15 V7 M7 7 L8 20 H16 L17 7" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                </DockPanel>
                            </Border>

                        </StackPanel>

                        <!-- ============ SETTINGS SECTION ============ -->
                        <StackPanel IsVisible="{Binding IsSettingsSection}" Margin="0,22,0,0" Spacing="18">
                            <TextBlock Text="Workspace settings" FontFamily="{StaticResource HeadingFont}" FontSize="20"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                <!-- Units -->
                                <Border Grid.Column="0" BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                        CornerRadius="7" Padding="18">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Units" FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="Units available when creating stock items."
                                                       FontSize="12" Foreground="{StaticResource TextMuted}" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Classes="field" Text="{Binding NewUnitText}"
                                                     PlaceholderText="e.g. pallet" />
                                            <Button Grid.Column="1" Classes="primary" Padding="12,8"
                                                    Command="{Binding AddUnitCommand}" Content="Add" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Units}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,0,1"
                                                            Padding="0,8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding}" FontSize="13"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <Button Grid.Column="1" Classes="bare" Content="Remove"
                                                                    Foreground="{StaticResource Danger}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).RemoveUnitCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Users -->
                                <Border Grid.Column="1" BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                        CornerRadius="7" Padding="18">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Users" FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="Manage people who can use this workspace."
                                                       FontSize="12" Foreground="{StaticResource TextMuted}" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Classes="field" Text="{Binding NewUserPhone}"
                                                     PlaceholderText="Cambodian phone number" />
                                            <TextBox Grid.Column="1" Classes="field" Text="{Binding NewUserRole}"
                                                     PlaceholderText="Role" />
                                            <Button Grid.Column="2" Classes="primary" Padding="12,8"
                                                    Command="{Binding AddUserCommand}" Content="Add" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Users}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,0,1"
                                                            Padding="0,8">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding}" FontSize="13"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <Button Grid.Column="1" Classes="bare" Content="Remove"
                                                                    Foreground="{StaticResource Danger}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).RemoveUserCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- System -->
                            <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                    CornerRadius="7" Padding="18">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="System" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="Regional and application preferences."
                                                   FontSize="12" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="180,220,*" ColumnSpacing="12">
                                        <TextBlock Text="Interface language" FontSize="13"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                        <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding Languages}"
                                                  SelectedItem="{Binding SelectedLanguage}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SettingsStatus}" FontSize="12"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ CHECKOUT SECTION ============ -->
                        <Grid IsVisible="{Binding IsCheckoutSection}" Margin="0,22,0,0"
                              ColumnDefinitions="*,360" ColumnSpacing="20">

                            <!-- Left: verify line items -->
                            <StackPanel Grid.Column="0" Spacing="12">
                                <!-- Customer details: compact and kept above the item list so a
                                     long list can grow and scroll underneath it.
                                     Printed on the receipt only - never stored in the database. -->
                                <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                        CornerRadius="7" Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding CustomerDetailsText}" FontSize="14"
                                                       FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Text="Optional - receipt only, not saved"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextFaint}" />
                                        </Grid>
                                        <CheckBox IsChecked="{Binding IsWalkInInvoice}" FontSize="12"
                                                  Content="Simple walk-in invoice (no customer details)" />
                                        <!-- Name / phone / address on one row keeps this panel short -->
                                        <Grid ColumnDefinitions="*,150,*" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Classes="fieldLabel" Text="NAME" Margin="0" />
                                                <TextBox Classes="field" Padding="8,6" FontSize="13"
                                                         Text="{Binding CustomerName}"
                                                         PlaceholderText="Walk-in Customer" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Classes="fieldLabel" Text="PHONE" Margin="0" />
                                                <TextBox Classes="field" Padding="8,6" FontSize="13"
                                                         Text="{Binding CustomerPhone}"
                                                         PlaceholderText="optional" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Classes="fieldLabel" Text="ADDRESS" Margin="0" />
                                                <TextBox Classes="field" Padding="8,6" FontSize="13"
                                                         Text="{Binding CustomerAddress}"
                                                         PlaceholderText="optional" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="fieldLabel" Text="ORDER NOTE" Margin="0" />
                                            <TextBox Classes="field" Padding="8,6" FontSize="13"
                                                     Text="{Binding OrderNote}"
                                                     PlaceholderText="Cutting instructions, delivery notes, etc." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Item list last: it takes the remaining height and scrolls -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Review Items" FontFamily="{StaticResource HeadingFont}"
                                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <Button Grid.Column="1" Classes="ghost" Command="{Binding BackToShoppingCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="icon" Width="15" Height="15" Data="M15 6 L9 12 L15 18" />
                                            <TextBlock Text="{Binding ContinueShoppingText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1" CornerRadius="7">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,132,120,96"
                                              Background="#EDECEB" Height="40">
                                            <TextBlock Classes="th" Text="ITEM" VerticalAlignment="Center" Margin="14,0,0,0" />
                                            <TextBlock Grid.Column="1" Classes="th" Text="QTY" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="th" Text="UNIT PRICE" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Classes="th" Text="TOTAL" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" />
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="560">
                                            <ItemsControl ItemsSource="{Binding Cart}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CartLine">
                                                        <Border BorderBrush="{StaticResource HairLine}"
                                                                BorderThickness="0,0,0,1" Padding="14,12">
                                                            <Grid ColumnDefinitions="*,132,120,96" VerticalAlignment="Center">
                                                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding Material}" FontSize="13"
                                                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                                                               Foreground="{StaticResource TextPrimary}" />
                                                                    <TextBlock Text="{Binding DimensionDisplay}" FontSize="12"
                                                                               Foreground="{StaticResource TextMuted}" />
                                                                </StackPanel>

                                                                <!-- Adjust quantity -->
                                                                <Border Grid.Column="1" BorderThickness="1"
                                                                        BorderBrush="{StaticResource Accent}"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Button Classes="qtyStep" Content="−"
                                                                                Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).DecrementLineCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                        <TextBlock Text="{Binding Quantity}" Classes="mono"
                                                                                   Width="30" FontSize="13" FontWeight="Bold"
                                                                                   TextAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource TextPrimary}" />
                                                                        <Button Classes="qtyStep" Content="+"
                                                                                Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).IncrementLineCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Adjust unit price -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                            Spacing="5" VerticalAlignment="Center">
                                                                    <TextBlock Text="$" FontSize="13"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextMuted}" />
                                                                    <TextBox Classes="field" Width="80" Padding="6,6"
                                                                             Text="{Binding UnitPrice}" />
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="3" Text="{Binding LineTotalLabel}"
                                                                           FontSize="14" FontWeight="Bold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextPrimary}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                            </StackPanel>

                            <!-- Right: payment summary -->
                            <Border Grid.Column="1" BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                    CornerRadius="7" Padding="18" VerticalAlignment="Top">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Payment Summary" FontFamily="{StaticResource HeadingFont}" FontSize="18"
                                               FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Subtotal" FontSize="13"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SubtotalLabel}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Classes="fieldLabel" Text="DISCOUNT ($)" />
                                            <TextBox Classes="field" Text="{Binding DiscountText}" PlaceholderText="0.00" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Classes="fieldLabel" Text="TAX (%)" />
                                            <TextBox Classes="field" Text="{Binding TaxRateText}" PlaceholderText="0" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource HairLine}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Discount" FontSize="13"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DiscountLabel}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Tax" FontSize="13"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TaxLabel}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </Grid>

                                    <Border Height="2" Background="{StaticResource TextPrimary}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="TOTAL" Classes="mono" FontSize="13"
                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding GrandTotalLabel}" FontSize="24"
                                                   FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                    </Grid>

                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="fieldLabel" Text="PAYMENT METHOD" />
                                        <!-- Segmented control (matches the design's .seg / .seg-opt) -->
                                        <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                                CornerRadius="4">
                                            <UniformGrid Columns="3">
                                                <Button Classes="segbtn" Classes.on="{Binding IsPaymentCash}"
                                                        Padding="6,9" Content="Cash"
                                                        Command="{Binding SelectPaymentMethodCommand}"
                                                        CommandParameter="Cash" />
                                                <Button Classes="segbtn" Classes.on="{Binding IsPaymentCard}"
                                                        Padding="6,9" Content="Card"
                                                        BorderBrush="{StaticResource HairLine}" BorderThickness="1,0,0,0"
                                                        Command="{Binding SelectPaymentMethodCommand}"
                                                        CommandParameter="Card" />
                                                <Button Classes="segbtn" Classes.on="{Binding IsPaymentBank}"
                                                        Padding="6,9" Content="Bank Transfer"
                                                        BorderBrush="{StaticResource HairLine}" BorderThickness="1,0,0,0"
                                                        Command="{Binding SelectPaymentMethodCommand}"
                                                        CommandParameter="Bank Transfer" />
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="fieldLabel" Text="AMOUNT PAID" />
                                        <TextBox Classes="field" Text="{Binding AmountPaidText}"
                                                 PlaceholderText="exact amount" />
                                    </StackPanel>

                                    <Border Background="{StaticResource ChipBg}" CornerRadius="8" Padding="12,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Change due" FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ChangeLabel}" FontSize="15"
                                                       FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                        </Grid>
                                    </Border>

                                    <Button Classes="primary" CornerRadius="4" HorizontalAlignment="Stretch"
                                            Padding="12,14" Command="{Binding CompleteSaleCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                            <Path Classes="icon" Width="17" Height="17" Stroke="{StaticResource Accent}"
                                                  Data="M5 12 L10 17 L19 7" />
                                            <TextBlock Text="{Binding CompleteSalePrintText}" FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{Binding CheckoutStatus}" FontSize="12" TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource Danger}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ============ ORDER COMPLETED SECTION ============ -->
                        <Grid IsVisible="{Binding IsCompleteSection}" Margin="0,22,0,0">
                            <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1" CornerRadius="7"
                                    MaxWidth="660" HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Background="{StaticResource Surface}">
                                <StackPanel>
                                    <!-- Success banner -->
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="0,0,0,1"
                                            CornerRadius="12,12,0,0" Padding="24,22">
                                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                                            <Border Width="56" Height="56" CornerRadius="28" Background="#16A34A"
                                                    HorizontalAlignment="Center">
                                                <Path Width="30" Height="30" Stroke="White" StrokeThickness="2.6"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      Data="M5 12 L10 17 L19 7" />
                                            </Border>
                                            <TextBlock Text="Order Completed" FontFamily="{StaticResource HeadingFont}"
                                                       FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="#14532D" />
                                            <TextBlock FontSize="13" HorizontalAlignment="Center"
                                                       Foreground="#166534">
                                                <Run Text="Sale" />
                                                <Run Text="{Binding CompletedSaleNumber}" FontWeight="Bold" />
                                                <Run Text="·" />
                                                <Run Text="{Binding CompletedItemSummary}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding CompletedTimestamp}" FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Customer -->
                                    <StackPanel Margin="24,18,24,0" Spacing="3">
                                        <TextBlock Classes="mono" Text="CUSTOMER" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding CompletedCustomer}" FontSize="15"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding CompletedContact}" FontSize="12"
                                                   IsVisible="{Binding CompletedHasContact}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>

                                    <!-- Items sold -->
                                    <StackPanel Margin="24,16,24,0" Spacing="6">
                                        <TextBlock Classes="mono" Text="ITEMS" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1">
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="240">
                                                <ItemsControl ItemsSource="{Binding CompletedLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:CartLine">
                                                            <Border BorderBrush="{StaticResource HairLine}"
                                                                    BorderThickness="0,0,0,1" Padding="12,9">
                                                                <Grid ColumnDefinitions="*,54,90,84">
                                                                    <StackPanel Grid.Column="0" Spacing="1"
                                                                                Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding Material}" FontSize="13"
                                                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                                                   Foreground="{StaticResource TextPrimary}" />
                                                                        <TextBlock Text="{Binding DimensionDisplay}"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource TextMuted}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity}"
                                                                               Classes="mono" FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextAlignment="Center"
                                                                               Foreground="{StaticResource TextMuted}" />
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding UnitPriceLabel}"
                                                                               FontSize="12" VerticalAlignment="Center"
                                                                               TextAlignment="Right"
                                                                               Foreground="{StaticResource TextMuted}" />
                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding LineTotalLabel}"
                                                                               FontSize="13" FontWeight="Bold"
                                                                               VerticalAlignment="Center"
                                                                               TextAlignment="Right"
                                                                               Foreground="{StaticResource TextPrimary}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>

                                    <!-- Totals -->
                                    <StackPanel Margin="24,16,24,0" Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Subtotal" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CompletedSubtotalLabel}"
                                                       FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CompletedHasDiscount}">
                                            <TextBlock Grid.Column="0" Text="Discount" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CompletedDiscountLabel}"
                                                       FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CompletedHasTax}">
                                            <TextBlock Grid.Column="0" Text="Tax" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CompletedTaxLabel}"
                                                       FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                        </Grid>
                                        <Border Height="2" Background="{StaticResource TextPrimary}" Margin="0,4,0,2" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="mono" Text="TOTAL PAID" FontSize="13"
                                                       FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CompletedTotalLabel}"
                                                       FontSize="26" FontWeight="Bold"
                                                       Foreground="{StaticResource Accent}" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Payment breakdown -->
                                    <Border Margin="24,14,24,0" Background="{StaticResource ChipBg}" Padding="14,12">
                                        <Grid ColumnDefinitions="*,*,*">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Classes="mono" Text="METHOD" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Text="{Binding CompletedPaymentLabel}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Classes="mono" Text="PAID" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Text="{Binding CompletedPaidLabel}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Classes="mono" Text="CHANGE" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Text="{Binding CompletedChangeLabel}" FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource Accent}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Note -->
                                    <StackPanel Margin="24,14,24,0" Spacing="3"
                                                IsVisible="{Binding CompletedHasNote}">
                                        <TextBlock Classes="mono" Text="NOTE" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding CompletedNote}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>

                                    <!-- Receipt reprint -->
                                    <Button Classes="link" Margin="24,14,24,0"
                                            HorizontalAlignment="Center"
                                            Command="{Binding ReprintReceiptCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Accent}"
                                                  Data="M7 8 V4 H17 V8 M7 17 H5 V10 H19 V17 H17 M7 14 H17 V20 H7 Z" />
                                            <TextBlock Text="Print receipt again" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Accent}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Actions -->
                                    <Grid Margin="24,18,24,22" ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <Button Grid.Column="0" Classes="ghost" Padding="12,14"
                                                Command="{Binding StartNewOrderCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        HorizontalAlignment="Center">
                                                <Path Classes="icon" Width="16" Height="16"
                                                      Data="M12 5 V19 M5 12 H19" />
                                                <TextBlock Text="New Order" FontWeight="Bold"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="primary" Padding="12,14"
                                                Command="{Binding AcknowledgeCompleteCommand}">
                                            <TextBlock Text="OK" FontWeight="Bold" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ============ ORDERS / HISTORY SECTION ============ -->
                        <StackPanel IsVisible="{Binding IsOrdersSection}" Margin="0,22,0,0" Spacing="12">
                            <Grid ColumnDefinitions="*,300" ColumnSpacing="12">
                                <Border Grid.Column="0" Background="{StaticResource ChipBg}" CornerRadius="10"
                                        Padding="16,12">
                                    <TextBlock Text="{Binding OrdersSummaryDisplay}" FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}" />
                                </Border>
                                <TextBox Grid.Column="1" Classes="field" Text="{Binding OrderSearchText}"
                                         VerticalAlignment="Center"
                                         PlaceholderText="{Binding SearchOrdersPlaceholder}" />
                            </Grid>
                            <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1" CornerRadius="7">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="140,120,*,90,110,140"
                                          Background="#EDECEB" Height="40">
                                        <TextBlock Classes="th" Text="{Binding ReceiptNoText}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <TextBlock Grid.Column="1" Classes="th" Text="{Binding DateText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="th" Text="{Binding CustomerText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Classes="th" Text="{Binding ItemsText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Classes="th" Text="{Binding TotalText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Classes="th" Text="{Binding ActionsText}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="540">
                                        <ItemsControl ItemsSource="{Binding RecentSales}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:Sale">
                                                    <Border BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,0,1"
                                                            Padding="14,11">
                                                        <Grid ColumnDefinitions="140,120,*,90,110,140"
                                                              VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ReceiptNoDisplay}" Classes="mono"
                                                                       FontSize="13" FontWeight="Bold"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Accent}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DateDisplay}"
                                                                       FontSize="13" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding CustomerDisplay}"
                                                                       FontSize="13" VerticalAlignment="Center"
                                                                       Margin="0,0,10,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding ItemCountDisplay}"
                                                                       FontSize="13" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding TotalDisplay}"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                                        Spacing="6" VerticalAlignment="Center">
                                                                <Button Classes="ghost" Padding="10,6"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).OpenOrderDetailCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock Text="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).ViewText}" FontSize="12" />
                                                                </Button>
                                                                <Button Classes="iconBtn"
                                                                        ToolTip.Tip="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).PrintReceiptText}"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).PrintOrderCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Path Classes="icon" Width="15" Height="15"
                                                                          Data="M7 8 V4 H17 V8 M7 17 H5 V10 H19 V17 H17 M7 14 H17 V20 H7 Z" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ ORDER DETAIL (full page) ============ -->
                        <StackPanel IsVisible="{Binding $parent[Window].((vm:MaterialSelectionViewModel)DataContext).IsOrderDetailSection}"
                                    Margin="0,20,0,0" Spacing="16"
                                    DataContext="{Binding SelectedOrder}">
                            <!-- Top bar: back + receipt no + print -->
                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                <Button Grid.Column="0" Classes="ghost"
                                        Command="{Binding $parent[Window].((vm:MaterialSelectionViewModel)DataContext).CloseOrderDetailCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="icon" Width="15" Height="15" Data="M15 6 L9 12 L15 18" />
                                        <TextBlock Text="Back to Orders" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="1" Spacing="2" Margin="18,0,0,0">
                                    <TextBlock Classes="mono" Text="{Binding ReceiptNoDisplay}" FontSize="20"
                                               FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                    <TextBlock Text="{Binding TimestampDisplay}" FontSize="12"
                                               Foreground="{StaticResource TextMuted}" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="primary" Padding="16,11"
                                        Command="{Binding $parent[Window].((vm:MaterialSelectionViewModel)DataContext).PrintSelectedOrderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Path Classes="icon" Width="17" Height="17" Stroke="{StaticResource Accent}"
                                              Data="M7 8 V4 H17 V8 M7 17 H5 V10 H19 V17 H17 M7 14 H17 V20 H7 Z" />
                                        <TextBlock Text="Print Receipt" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,340" ColumnSpacing="20">
                                <!-- Left: items -->
                                <StackPanel Grid.Column="0" Spacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="mono" Text="CUSTOMER" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding CustomerDisplay}" FontSize="15" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding ContactDisplay}" FontSize="12" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasContact}"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>

                                    <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1" CornerRadius="7">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,70,110,110"
                                                  Background="#EDECEB" Height="40">
                                                <TextBlock Classes="th" Text="ITEM" VerticalAlignment="Center" Margin="14,0,0,0" />
                                                <TextBlock Grid.Column="1" Classes="th" Text="QTY" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Classes="th" Text="UNIT PRICE" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Classes="th" Text="TOTAL" VerticalAlignment="Center" />
                                            </Grid>
                                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" />
                                            <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MaterialSelectionViewModel)DataContext).SelectedOrderItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SaleItem">
                                                        <Border BorderBrush="{StaticResource HairLine}"
                                                                BorderThickness="0,0,0,1" Padding="14,10">
                                                            <Grid ColumnDefinitions="*,70,110,110" VerticalAlignment="Center">
                                                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding Material}" FontSize="13"
                                                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                                                               Foreground="{StaticResource TextPrimary}" />
                                                                    <TextBlock Text="{Binding DimensionDisplay}" FontSize="12"
                                                                               Foreground="{StaticResource TextMuted}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding Quantity}"
                                                                           Classes="mono" FontSize="13"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMuted}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding UnitPriceDisplay}"
                                                                           FontSize="13" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMuted}" />
                                                                <TextBlock Grid.Column="3" Text="{Binding LineTotalDisplay}"
                                                                           FontSize="14" FontWeight="Bold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextPrimary}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>

                                    <StackPanel Spacing="3" IsVisible="{Binding HasNote}">
                                        <TextBlock Classes="mono" Text="NOTE" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: money breakdown -->
                                <Border Grid.Column="1" BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                        CornerRadius="7" Padding="18" VerticalAlignment="Top">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Payment Summary" FontFamily="{StaticResource HeadingFont}" FontSize="17"
                                                   FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Subtotal" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SubtotalDisplay}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasDiscount}">
                                            <TextBlock Grid.Column="0" Text="Discount" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DiscountDisplay}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasTax}">
                                            <TextBlock Grid.Column="0" Text="Tax" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding TaxDisplay}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimary}" />
                                        </Grid>
                                        <Border Height="2" Background="{StaticResource TextPrimary}" Margin="0,2" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="mono" Text="TOTAL" FontSize="13"
                                                       FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding TotalDisplay}" FontSize="22"
                                                       FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                        </Grid>
                                        <Border Background="{StaticResource ChipBg}" Padding="12,10" Margin="0,4,0,0">
                                            <Grid ColumnDefinitions="*,*,*">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Classes="mono" Text="METHOD" FontSize="10"
                                                               Foreground="{StaticResource TextMuted}" />
                                                    <TextBlock Text="{Binding PaymentMethod}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Classes="mono" Text="PAID" FontSize="10"
                                                               Foreground="{StaticResource TextMuted}" />
                                                    <TextBlock Text="{Binding AmountPaidDisplay}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2">
                                                    <TextBlock Classes="mono" Text="CHANGE" FontSize="10"
                                                               Foreground="{StaticResource TextMuted}" />
                                                    <TextBlock Text="{Binding ChangeDueDisplay}" FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource Accent}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding $parent[Window].((vm:MaterialSelectionViewModel)DataContext).OrderDetailStatus}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ============ REPORTS SECTION ============ -->
                        <StackPanel IsVisible="{Binding IsReportsSection}" Margin="0,20,0,0" Spacing="16">
                            <!-- Period toggle -->
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                        Background="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="segbtn" Classes.on="{Binding IsDailyReport}"
                                                Command="{Binding SetReportPeriodCommand}" CommandParameter="Daily"
                                                Content="{Binding DailyText}" />
                                        <Button Classes="segbtn" Classes.on="{Binding IsWeeklyReport}"
                                                Command="{Binding SetReportPeriodCommand}" CommandParameter="Weekly"
                                                Content="{Binding WeeklyText}" />
                                        <Button Classes="segbtn" Classes.on="{Binding IsMonthlyReport}"
                                                Command="{Binding SetReportPeriodCommand}" CommandParameter="Monthly"
                                                Content="{Binding MonthlyText}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding ReportRangeLabel}" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"
                                           Foreground="{StaticResource TextPrimary}" />
                            </Grid>

                            <!-- Summary cards -->
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                                <Border Grid.Column="0" Classes="statCard">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="mono" Text="{Binding OrdersText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding ReportOrdersLabel}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Classes="statCard">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="mono" Text="{Binding RevenueText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding ReportRevenueLabel}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{StaticResource Accent}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="statCard">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="mono" Text="{Binding ItemsSoldText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding ReportItemsLabel}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Classes="statCard">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="mono" Text="{Binding AvgOrderText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding ReportAvgOrderLabel}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Units sold per type + category breakdown -->
                            <Grid ColumnDefinitions="*,300" ColumnSpacing="16">
                                <!-- Per-product table -->
                                <Border Grid.Column="0" BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                        CornerRadius="7">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,110,80,110"
                                              Background="#EDECEB" Height="40">
                                            <TextBlock Classes="th" Text="{Binding ProductTypeText}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                            <TextBlock Grid.Column="1" Classes="th" Text="{Binding DimensionText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="th" Text="{Binding SoldText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Classes="th" Text="{Binding RevenueHeaderText}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" />
                                        <Border DockPanel.Dock="Top" Padding="14,10"
                                                IsVisible="{Binding !ReportProducts.Count}">
                                            <TextBlock Text="{Binding ReportProductSummaryDisplay}" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" />
                                        </Border>
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="460">
                                            <ItemsControl ItemsSource="{Binding ReportProducts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ProductSalesRow">
                                                        <Border BorderBrush="{StaticResource HairLine}"
                                                                BorderThickness="0,0,0,1" Padding="14,10">
                                                            <Grid ColumnDefinitions="*,110,80,110" VerticalAlignment="Center">
                                                                <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding ProductName}" FontSize="13"
                                                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                                                               Foreground="{StaticResource TextPrimary}" />
                                                                    <TextBlock Text="{Binding CategoryDisplay}" FontSize="11"
                                                                               Foreground="{StaticResource TextFaint}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding DimensionDisplay}"
                                                                           FontSize="12" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMuted}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding QuantityDisplay}"
                                                                           FontSize="13" FontWeight="Bold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextPrimary}" />
                                                                <TextBlock Grid.Column="3" Text="{Binding RevenueDisplay}"
                                                                           FontSize="13" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextPrimary}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- By category -->
                                <Border Grid.Column="1" BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                        CornerRadius="7" Padding="16" VerticalAlignment="Top">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding ByCategoryText}" FontFamily="{StaticResource HeadingFont}" FontSize="16"
                                                   FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                        <ItemsControl ItemsSource="{Binding ReportCategories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:CategorySalesRow">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                                        <StackPanel Grid.Column="0" Spacing="1">
                                                            <TextBlock Text="{Binding CategoryDisplay}" FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <TextBlock Text="{Binding QuantityDisplay}" FontSize="11"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding RevenueDisplay}"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Accent}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Bottom spacer so the last row/card clears the viewport edge when scrolled -->
                        <Border Height="76" Background="Transparent" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Click-outside catcher: collapses the expanded cart back to the rail. -->
                <Border Grid.Column="0" Background="Transparent" IsVisible="{Binding IsCartExpanded}"
                        PointerPressed="CartScrim_PointerPressed" />

                <!-- Cart: permanent on wide screens; a thin, tappable rail on smaller screens. -->
                <Border Grid.Column="1" Width="{Binding CartPanelWidth}"
                        IsVisible="{Binding IsTechnicalPanelVisible}" ClipToBounds="True"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource HairLine}" BorderThickness="1,0,0,0">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
                        </Transitions>
                    </Border.Transitions>
                    <Panel>
                        <!-- Collapsed rail (smaller screens only): click to expand; raw item names + amounts -->
                        <Button IsVisible="{Binding ShowCartRail}" Classes="bare" Padding="0"
                                Command="{Binding ToggleCartExpandedCommand}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <DockPanel LastChildFill="True">
                                <!-- Header -->
                                <StackPanel DockPanel.Dock="Top" Spacing="7" Margin="12,18,12,12">
                                    <TextBlock Classes="mono" Text="CART" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                    <Border IsVisible="{Binding HasCartBadge}" Background="{StaticResource PeachTile}"
                                            CornerRadius="10" Padding="9,2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CartItemCount}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentDark}" />
                                    </Border>
                                </StackPanel>
                                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" />

                                <!-- Total pinned at the bottom -->
                                <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding !IsCartEmpty}" Spacing="6"
                                            Margin="12,10,12,16">
                                    <Border Height="1" Background="{StaticResource HairLine}" />
                                    <TextBlock Text="{Binding CartTotalLabel}" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                </StackPanel>

                                <!-- Empty state -->
                                <TextBlock DockPanel.Dock="Top" IsVisible="{Binding IsCartEmpty}" Text="Empty"
                                           FontSize="11" Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center" Margin="0,16,0,0" />

                                <!-- Item list -->
                                <ScrollViewer IsVisible="{Binding !IsCartEmpty}" HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto" Padding="12,10,10,4">
                                    <ItemsControl ItemsSource="{Binding Cart}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CartLine">
                                                <Border BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,0,1"
                                                        Padding="0,0,0,9" Margin="0,0,0,9">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Material}" FontSize="12" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                                   LineHeight="15" Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock Text="{Binding LineTotalLabel}" FontSize="12" FontWeight="Bold"
                                                                   Foreground="{StaticResource Accent}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Button>

                    <!-- Full cart contents (always on wide screens, or when the rail is expanded) -->
                    <DockPanel Margin="20,24" IsVisible="{Binding ShowCartContents}">
                        <!-- Header -->
                        <StackPanel DockPanel.Dock="Top" Spacing="3">
                            <TextBlock Classes="mono" Text="CURRENT SALE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" />
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Classes="cardTitle" Text="Cart" VerticalAlignment="Center" />
                                <Border Grid.Column="1" IsVisible="{Binding HasCartBadge}" VerticalAlignment="Center"
                                        Background="{StaticResource PeachTile}" CornerRadius="10" Padding="9,3">
                                    <TextBlock Text="{Binding CartItemCount}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource AccentDark}" />
                                </Border>
                                <!-- Collapse back to the rail (smaller screens only) -->
                                <Button Grid.Column="2" Classes="bare" IsVisible="{Binding !IsWideLayout}"
                                        Command="{Binding ToggleCartExpandedCommand}" Width="30" Height="30"
                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Path Classes="icon" Width="16" Height="16" Data="M9 6 L15 12 L9 18" />
                                </Button>
                            </Grid>
                        </StackPanel>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" Margin="0,14,0,0" />

                        <!-- Total + checkout pinned bottom (only when the cart has items) -->
                        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0"
                                    IsVisible="{Binding !IsCartEmpty}">
                            <Border Height="1" Background="{StaticResource HairLine}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Total" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock Grid.Column="1" Text="{Binding CartTotalLabel}" FontSize="20"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                            <Button Classes="primary" HorizontalAlignment="Stretch"
                                    Command="{Binding GoToCheckoutCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CheckoutText}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding CartTotalLabel}" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost" HorizontalAlignment="Stretch"
                                    Command="{Binding NewSaleCommand}" Content="Clear cart" />
                        </StackPanel>

                        <!-- Live item list (or empty state) -->
                        <Grid Margin="0,14,0,0">
                            <StackPanel IsVisible="{Binding IsCartEmpty}" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" Spacing="12">
                                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource ChipBg}">
                                    <Path Classes="icon" Width="24" Height="24"
                                          Data="M3 4 H5 L7.2 15 H18 L20 7 H6 M8.5 19 a1.2 1.2 0 1 0 0.01 0 M17 19 a1.2 1.2 0 1 0 0.01 0" />
                                </Border>
                                <TextBlock Text="No items yet" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Pick a category and add items to build the current sale."
                                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"
                                           Foreground="{StaticResource TextMuted}" />
                            </StackPanel>

                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding !IsCartEmpty}">
                                <ItemsControl ItemsSource="{Binding Cart}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CartLine">
                                            <Border BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,0,1"
                                                    Padding="12,10,0,10">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Material}" FontSize="13"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                                                            <Run Text="{Binding DimensionDisplay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding Quantity}" />
                                                            <Run Text=" ×" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding LineTotalLabel}"
                                                               FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                                               Margin="0,0,6,0"
                                                               Foreground="{StaticResource TextPrimary}" />
                                                    <Button Grid.Column="2" Classes="bare" Width="24" Height="24"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).RemoveLineCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Path Classes="icon" Width="13" Height="13"
                                                              Stroke="{StaticResource Danger}"
                                                              Data="M6 6 L18 18 M18 6 L6 18" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                    </Panel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- ===== Product detail drawer (adjust price + quantity, then add) ===== -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" IsHitTestVisible="{Binding IsProductDetailOpen}"
               ClipToBounds="True">
            <Button Classes="scrim" Classes.open="{Binding IsProductDetailOpen}"
                    Command="{Binding CloseProductDetailCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Border Classes="drawer" Classes.open="{Binding IsProductDetailOpen}"
                    Width="420" HorizontalAlignment="Right" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource HairLine}" BorderThickness="1,0,0,0"
                    BoxShadow="-8 0 30 0 #1A000000">
                <DockPanel>
                    <!-- Header: category tag + name + dimension + close -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,20,0">
                        <StackPanel Grid.Column="0" Spacing="8">
                            <Border Background="{StaticResource ChipBg}" CornerRadius="6" Padding="8,4"
                                    HorizontalAlignment="Left">
                                <TextBlock Classes="mono" Text="{Binding DetailCategoryTag}" FontSize="11"
                                           Foreground="{StaticResource TextMuted}" />
                            </Border>
                            <TextBlock Text="{Binding DetailProductName}"
                                       FontFamily="{StaticResource HeadingFont}" FontSize="24"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding DetailDimensionText}" FontSize="13"
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="bare" VerticalAlignment="Top"
                                Command="{Binding CloseProductDetailCommand}" Width="30" Height="30">
                            <Path Classes="icon" Width="16" Height="16" Data="M6 6 L18 18 M18 6 L6 18" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" Margin="0,16,0,0" />

                    <!-- Footer: line total + add to cart -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HairLine}"
                            BorderThickness="0,1,0,0" Padding="24,16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding DetailLineTotalTitle}" FontSize="16"
                                           FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Grid.Column="1" Text="{Binding DetailLineTotalLabel}" FontSize="18"
                                           FontFamily="{StaticResource HeadingFont}" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                            <Button Classes="primary" HorizontalAlignment="Stretch"
                                    Command="{Binding AddDetailToCartCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource Accent}"
                                          Data="M3 4 H5 L7.2 15 H18 L20 7 H6 M8.5 19 a1.2 1.2 0 1 0 0.01 0 M17 19 a1.2 1.2 0 1 0 0.01 0" />
                                    <TextBlock Text="{Binding AddToCartText}" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Body -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="24,18,24,0">
                        <StackPanel Spacing="18">
                            <!-- Product image (placeholder until images are stored) -->
                            <Border Height="200" CornerRadius="7" Background="#EDECEB"
                                    BorderBrush="{StaticResource HairLine}" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                    <Border Width="56" Height="56" CornerRadius="12"
                                            Background="{StaticResource PeachTile}">
                                        <Path Classes="icon" Width="28" Height="28" Stroke="{StaticResource Accent}"
                                              Data="M4 5 H20 V19 H4 Z M4 15 L9 10 L13 14 L16 11 L20 15" />
                                    </Border>
                                    <TextBlock Text="No product image" FontSize="12"
                                               Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Stock availability -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Width="15" Height="15"
                                      Data="M12 3 L20 7 V17 L12 21 L4 17 V7 Z M4 7 L12 11 L20 7 M12 11 V21" />
                                <TextBlock Text="{Binding DetailStockText}" FontSize="13"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>

                            <!-- Adjust unit price + quantity: two identical boxes -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{Binding DetailUnitPriceLabel}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                    <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                            CornerRadius="4" Height="44" Background="Transparent">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="$" FontSize="14" VerticalAlignment="Center"
                                                       Margin="12,0,2,0" Foreground="{StaticResource TextMuted}" />
                                            <TextBox Grid.Column="1" Classes="searchInput" Text="{Binding DetailUnitPriceText}"
                                                     FontSize="15" VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center" Padding="0,0,12,0"
                                                     Background="Transparent" BorderThickness="0" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{Binding DetailQuantityLabel}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                    <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                            CornerRadius="4" Height="44">
                                        <Grid ColumnDefinitions="44,*,44">
                                            <Button Grid.Column="0" Classes="qtyStep" Content="−"
                                                    Width="44" Height="44"
                                                    Command="{Binding DecrementDetailQuantityCommand}" />
                                            <TextBlock Grid.Column="1" Text="{Binding DetailQuantity}" Classes="mono"
                                                       FontSize="15" FontWeight="Bold" TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <Button Grid.Column="2" Classes="qtyStep" Content="+"
                                                    Width="44" Height="44"
                                                    Command="{Binding IncrementDetailQuantityCommand}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- ===== Modal drawer: Select Dimensions ===== -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" IsHitTestVisible="{Binding IsDetailOpen}"
               ClipToBounds="True">
            <!-- Scrim (click to close) -->
            <Button Classes="scrim" Classes.open="{Binding IsDetailOpen}"
                    Command="{Binding CloseDetailCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Drawer -->
            <Border Classes="drawer" Classes.open="{Binding IsDetailOpen}"
                    Width="480" HorizontalAlignment="Right" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource HairLine}" BorderThickness="1,0,0,0"
                    BoxShadow="-8 0 30 0 #1A000000">
                <DockPanel Margin="0">
                    <!-- Header -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,20,0">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="mono" Text="MATERIAL SPECS" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" />
                            <TextBlock Text="{Binding SelectDimensionsText}" FontFamily="{StaticResource HeadingFont}" FontSize="22"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding DetailMaterialName}" FontSize="13"
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="bare" VerticalAlignment="Top"
                                Command="{Binding CloseDetailCommand}" Width="30" Height="30">
                            <Path Classes="icon" Width="16" Height="16" Data="M6 6 L18 18 M18 6 L6 18" />
                        </Button>
                    </Grid>

                    <!-- Section label (the cart itself now lives in the left drawer) -->
                    <Border DockPanel.Dock="Top" Margin="24,18,24,0"
                            Background="{StaticResource Accent}" HorizontalAlignment="Left" Padding="18,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="White"
                                  Data="M5 12 L10 17 L19 7" />
                            <TextBlock Classes="mono" Text="{Binding SelectionText}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="White" />
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" Margin="0,16,0,0" />

                    <!-- Bottom action bar -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HairLine}" BorderThickness="0,1,0,0"
                            Padding="24,16">
                        <Button Classes="primary" CornerRadius="4" HorizontalAlignment="Stretch"
                                Command="{Binding AddSelectedToCartCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Path Classes="icon" Width="17" Height="17" Stroke="{StaticResource Accent}"
                                      Data="M3 4 H5 L7.2 15 H18 L20 7 H6 M8.5 19 a1.2 1.2 0 1 0 0.01 0 M17 19 a1.2 1.2 0 1 0 0.01 0" />
                                <TextBlock Text="{Binding AddToCartText}" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Body -->
                    <Grid Margin="24,18,24,0">
                        <!-- Product selection list -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ListBox Classes="dims" ItemsSource="{Binding CategoryProducts}"
                                         SelectedItem="{Binding SelectedProduct}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Product">
                                            <Border CornerRadius="4" BorderThickness="1" Padding="12"
                                                    Background="{Binding $parent[ListBoxItem].IsSelected, Converter={StaticResource RowBg}, ConverterParameter=True}"
                                                    BorderBrush="{Binding $parent[ListBoxItem].IsSelected, Converter={StaticResource RowBorder}, ConverterParameter=True}">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" >
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="4"
                                                            Background="{StaticResource ChipBg}" VerticalAlignment="Center">
                                                        <Path Classes="icon" Width="22" Height="22"
                                                              Data="M4 9 H20 M4 9 L6 6 H18 L20 9 M4 9 V16 H20 V9 M9 9 V16 M14 9 V16" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Dimension}" FontSize="14"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock Text="{Binding LocalizedStockLabel}" FontSize="12"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding PriceLabel}" FontSize="14"
                                                               FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                                               VerticalAlignment="Center" Margin="10,0,14,0" />
                                                    <Panel Grid.Column="3" MinWidth="96" VerticalAlignment="Center">
                                                        <!-- Before adding: standard action. -->
                                                        <Button Classes="rowAdd" HorizontalAlignment="Right"
                                                                IsVisible="{Binding !IsInCart}"
                                                                Command="{Binding $parent[ListBox].((vm:MaterialSelectionViewModel)DataContext).AddProductToCartCommand}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Classes="mono" Text="{Binding $parent[ListBox].((vm:MaterialSelectionViewModel)DataContext).AddToCartUpperText}" FontSize="10"
                                                                       FontWeight="Bold" />
                                                        </Button>

                                                        <!-- In cart: swap the label for a light inline stepper. -->
                                                        <Border IsVisible="{Binding IsInCart}" HorizontalAlignment="Right"
                                                                Background="Transparent" BorderThickness="1"
                                                                BorderBrush="{StaticResource Accent}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Classes="qtyStep" Content="−"
                                                                        Command="{Binding $parent[ListBox].((vm:MaterialSelectionViewModel)DataContext).DecrementProductQuantityCommand}"
                                                                        CommandParameter="{Binding}" />
                                                                <TextBlock Text="{Binding CartQuantity}" Classes="mono"
                                                                           Width="30" FontSize="13" FontWeight="Bold"
                                                                           TextAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextPrimary}" />
                                                                <Button Classes="qtyStep" Content="+"
                                                                        IsEnabled="{Binding CanIncrease}"
                                                                        Command="{Binding $parent[ListBox].((vm:MaterialSelectionViewModel)DataContext).IncrementProductQuantityCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Panel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Technical documentation -->
                                <TextBlock Classes="mono" Text="{Binding TechnicalDocumentationText}" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" Margin="2,12,0,10" />
                                <Button Classes="link" Command="{Binding OpenDocumentCommand}"
                                        CommandParameter="{Binding DocSheetLabel}" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource Accent}"
                                              Data="M7 3 H14 L18 7 V21 H7 Z M14 3 V7 H18 M9.5 12 H15 M9.5 15.5 H15" />
                                        <TextBlock Text="{Binding DocSheetLabel}" FontSize="13"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="link" Command="{Binding OpenDocumentCommand}"
                                        CommandParameter="Certification of Compliance">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource Accent}"
                                              Data="M12 4 a5 5 0 1 0 0.01 0 M9.5 12 L11.5 14 L15 10" />
                                        <TextBlock Text="{Binding CertificationText}" FontSize="13"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Panel>

        <!-- ===== Modal drawer: Add / Edit Stock Item ===== -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" IsHitTestVisible="{Binding IsStockFormOpen}"
               ClipToBounds="True">
            <!-- Scrim (click to close) -->
            <Button Classes="scrim" Classes.open="{Binding IsStockFormOpen}"
                    Command="{Binding CloseStockFormCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Drawer -->
            <Border Classes="drawer" Classes.open="{Binding IsStockFormOpen}"
                    Width="440" HorizontalAlignment="Right" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource HairLine}" BorderThickness="1,0,0,0"
                    BoxShadow="-8 0 30 0 #1A000000">
                <DockPanel>
                    <!-- Header -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,20,0">
                        <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="mono" Text="{Binding NavInventoryText}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" />
                            <TextBlock Text="{Binding FormTitle}" FontFamily="{StaticResource HeadingFont}" FontSize="22"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="bare" VerticalAlignment="Top"
                                Command="{Binding CloseStockFormCommand}" Width="30" Height="30">
                            <Path Classes="icon" Width="16" Height="16" Data="M6 6 L18 18 M18 6 L6 18" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" Margin="0,16,0,0" />

                    <!-- Footer actions -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HairLine}" BorderThickness="0,1,0,0"
                            Padding="24,16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding StockStatus}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Button Grid.Column="0" Classes="ghost" Command="{Binding NewProductCommand}"
                                        Content="{Binding ClearText}" />
                                <Button Grid.Column="1" Classes="primary" Padding="12,12"
                                        Command="{Binding SaveProductCommand}"
                                        Content="{Binding SaveButtonLabel}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Body: form fields -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="24,18,24,0">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="fieldLabel" Text="{Binding MaterialNameText}" />
                                <TextBox Classes="field" Text="{Binding FormName}"
                                         PlaceholderText="{Binding MaterialPlaceholderText}" />
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock Classes="fieldLabel" Text="{Binding GroupCategoryText}" />
                                <ComboBox Classes="field" ItemsSource="{Binding CategoryChoices}"
                                          SelectedItem="{Binding SelectedCategoryChoice}" />
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock Classes="fieldLabel" Text="{Binding DimensionSpecText}" />
                                <TextBox Classes="field" Text="{Binding FormDimension}"
                                         PlaceholderText="{Binding DimensionPlaceholderText}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Classes="fieldLabel" Text="{Binding ItemPriceText}" />
                                    <TextBox Classes="field" Text="{Binding FormPriceText}" PlaceholderText="{Binding PricePlaceholderText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Classes="fieldLabel" Text="{Binding StockQtyLabelText}" />
                                    <TextBox Classes="field" Text="{Binding FormStockText}" PlaceholderText="{Binding StockPlaceholderText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- ===== Centered New Category modal ===== -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsNewCategoryModalOpen}"
               IsHitTestVisible="{Binding IsNewCategoryModalOpen}"
               ClipToBounds="True">
            <Button Classes="scrim" Classes.open="{Binding IsNewCategoryModalOpen}"
                    Command="{Binding CancelNewCategoryCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                    CornerRadius="7" BoxShadow="0 16 44 0 #33000000" Padding="28,24">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="mono" Text="{Binding NavInventoryText}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" />
                            <TextBlock Text="{Binding NewCategoryTitleText}" FontFamily="{StaticResource HeadingFont}"
                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="bare" VerticalAlignment="Top"
                                Command="{Binding CancelNewCategoryCommand}" Width="30" Height="30">
                            <Path Classes="icon" Width="16" Height="16" Data="M6 6 L18 18 M18 6 L6 18" />
                        </Button>
                    </Grid>
                    <StackPanel Spacing="3">
                        <TextBlock Classes="fieldLabel" Text="{Binding NewCategoryLabelText}" />
                        <TextBox Classes="field" Text="{Binding NewCategoryName}"
                                 PlaceholderText="{Binding CategoryPlaceholderText}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Grid.Column="0" Classes="primary" Padding="12,12"
                                Command="{Binding SaveNewCategoryCommand}" Content="{Binding SaveText}" />
                        <Button Grid.Column="1" Classes="ghost" Padding="16,12"
                                Command="{Binding CancelNewCategoryCommand}" Content="{Binding CancelText}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ===== Centered Settings Center modal ===== -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsSettingsOpen}"
               IsHitTestVisible="{Binding IsSettingsOpen}"
               ClipToBounds="True">
            <Button Classes="scrim" Classes.open="{Binding IsSettingsOpen}"
                    Command="{Binding CloseSettingsCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Border Width="900" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                    CornerRadius="7" BoxShadow="0 16 44 0 #33000000">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="28,24,24,0">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="mono" Text="ADMINISTRATION" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" />
                            <TextBlock Text="{Binding SettingsCenterText}" FontFamily="{StaticResource HeadingFont}" FontSize="27"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding SettingsDescriptionText}"
                                       FontSize="13" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="bare" Command="{Binding CloseSettingsCommand}"
                                Width="32" Height="32" VerticalAlignment="Top">
                            <Path Classes="icon" Width="17" Height="17" Data="M6 6 L18 18 M18 6 L6 18" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" Margin="0,20,0,0" />

                    <!-- Settings-style sidebar navigation -->
                    <Grid ColumnDefinitions="220,*">
                        <Border Grid.Column="0" Background="#EDECEB"
                                BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,1,0"
                                Padding="14,22">
                            <StackPanel Spacing="6">
                            <TextBlock Classes="mono" Text="{Binding SettingsNavText}" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" Margin="10,0,0,8" />
                                <Button Classes="settingsTab" Classes.active="{Binding IsUnitsSettingsTab}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="Units"
                                        HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="28" Height="28" CornerRadius="7" Background="#E0DEDC">
                                            <Path Classes="icon" Width="15" Height="15" Data="M5 5 H19 M5 12 H19 M5 19 H19" />
                                        </Border>
                                        <TextBlock Text="{Binding UnitsText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="settingsTab" Classes.active="{Binding IsUsersSettingsTab}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="Users"
                                        HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="28" Height="28" CornerRadius="7" Background="#E0DEDC">
                                            <Path Classes="icon" Width="15" Height="15"
                                                  Data="M12 11 a3 3 0 1 0 0.01 0 M6 20 a6 6 0 0 1 12 0" />
                                        </Border>
                                        <TextBlock Text="{Binding UsersText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="settingsTab" Classes.active="{Binding IsSystemSettingsTab}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="System"
                                        HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="28" Height="28" CornerRadius="7" Background="#E0DEDC">
                                            <Path Classes="icon" Width="15" Height="15"
                                                  Data="M12 3 V21 M3 12 H21 M5.6 5.6 L18.4 18.4 M18.4 5.6 L5.6 18.4" />
                                        </Border>
                                        <TextBlock Text="{Binding SystemText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="settingsTab" Classes.active="{Binding IsBackupSettingsTab}"
                                        Command="{Binding SelectSettingsTabCommand}" CommandParameter="Backup"
                                        HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="28" Height="28" CornerRadius="7" Background="#E0DEDC">
                                            <Path Classes="icon" Width="15" Height="15"
                                                  Data="M6 16 a4 4 0 0 1 1 -7.9 A5 5 0 0 1 17 8 a3.5 3.5 0 0 1 -0.5 7 H7 M12 9 V15 M9.5 12.5 L12 15 L14.5 12.5" />
                                        </Border>
                                        <TextBlock Text="{Binding BackupText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" Padding="30,28">
                        <StackPanel>
                        <!-- Units tab -->
                        <StackPanel IsVisible="{Binding IsUnitsSettingsTab}" Spacing="16">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Units" FontFamily="{StaticResource HeadingFont}" FontSize="21"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding UnitsText}"
                                           FontSize="13" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" MaxWidth="560">
                                <TextBox Grid.Column="0" Classes="field" Text="{Binding NewUnitText}"
                                         PlaceholderText="Add a unit, e.g. pallet" />
                                <Button Grid.Column="1" Classes="primary" Padding="16,10"
                                        Command="{Binding AddUnitCommand}" Content="{Binding AddUnitText}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Units}" MaxWidth="560">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,0,1"
                                                Padding="0,12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding}" FontSize="14"
                                                           Foreground="{StaticResource TextPrimary}" />
                                                <Button Grid.Column="1" Classes="bare" Content="Remove"
                                                        Foreground="{StaticResource Danger}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).RemoveUnitCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Users tab -->
                        <StackPanel IsVisible="{Binding IsUsersSettingsTab}" Spacing="16">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Users" FontFamily="{StaticResource HeadingFont}" FontSize="21"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Register a Cambodian phone number for staff sign-in."
                                           FontSize="13" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding CanManageUsers}" Spacing="10">
                                <Grid ColumnDefinitions="*,150" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                    <TextBox Grid.Row="0" Grid.Column="0" Classes="field" Text="{Binding NewUserPhone}"
                                             PlaceholderText="Phone: 012 345 678 or +855 12 345 678" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding NewUserRole}"
                                             PlaceholderText="Cashier" />
                                    <TextBox Grid.Row="1" Grid.Column="0" Classes="field" Text="{Binding NewUserPassword}"
                                             PasswordChar="●" PlaceholderText="Password (8+ characters)" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding NewUserPasswordConfirmation}"
                                             PasswordChar="●" PlaceholderText="Confirm password" />
                                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Classes="primary" Padding="16,10"
                                            HorizontalAlignment="Left" Command="{Binding AddUserCommand}" Content="Register phone" />
                                </Grid>
                                <TextBlock Text="{Binding SettingsStatus}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                            <Border IsVisible="{Binding IsUsersAccessRestricted}" Background="#FFF7ED"
                                    BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="8" Padding="12">
                                <TextBlock Text="Only the primary administrator account can register phone accounts."
                                           FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Users}" IsVisible="{Binding CanManageUsers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,0,1"
                                                Padding="0,12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding}" FontSize="14"
                                                           Foreground="{StaticResource TextPrimary}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- System tab -->
                        <StackPanel IsVisible="{Binding IsSystemSettingsTab}" Spacing="18">
                            <StackPanel Spacing="3">
                                <TextBlock Text="System" FontFamily="{StaticResource HeadingFont}" FontSize="21"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding SystemText}"
                                           FontSize="13" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                            <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                    CornerRadius="10" Padding="16">
                                <Grid ColumnDefinitions="180,200,*" ColumnSpacing="14">
                                    <TextBlock Text="{Binding InterfaceLanguageText}" FontSize="14"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                    <ComboBox Grid.Column="1" Classes="field" ItemsSource="{Binding Languages}"
                                              SelectedItem="{Binding SelectedLanguage}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SettingsStatus}" FontSize="12"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMuted}" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                    CornerRadius="10" Padding="16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Account" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="End this session and return to the sign-in screen."
                                                   FontSize="12" Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="secondary" Content="Sign out"
                                            Command="{Binding SignOutCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Backup tab -->
                        <StackPanel IsVisible="{Binding IsBackupSettingsTab}" Spacing="18">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding CloudBackupText}" FontFamily="{StaticResource HeadingFont}"
                                           FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding BackupDescriptionText}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}" MaxWidth="540"
                                           HorizontalAlignment="Left" />
                            </StackPanel>

                            <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1" CornerRadius="10"
                                    Padding="18" MaxWidth="560" HorizontalAlignment="Left">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding BackupStateText}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding SyncLabel}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding BackupServerText}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding BackupEndpoint}"
                                                   FontSize="12" Foreground="{StaticResource TextMuted}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource HairLine}" />

                                    <!-- Auto-backup interval: applies immediately on change -->
                                    <Grid ColumnDefinitions="*,160" ColumnSpacing="14">
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BackupIntervalText}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="{Binding BackupModeText}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextMuted}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Classes="field" VerticalAlignment="Center"
                                                  ItemsSource="{Binding BackupIntervals}"
                                                  SelectedItem="{Binding SelectedBackupInterval}"
                                                  IsEnabled="{Binding BackupEnabled}" />
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource HairLine}" />

                                    <TextBlock Text="{Binding BackupStatus}" FontSize="13" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimary}" />

                                    <Button Classes="primary" HorizontalAlignment="Left" Padding="18,11"
                                            Command="{Binding BackupNowCommand}" IsEnabled="{Binding BackupEnabled}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource Accent}"
                                                  Data="M6 16 a4 4 0 0 1 1 -7.9 A5 5 0 0 1 17 8 a3.5 3.5 0 0 1 -0.5 7 H7 M12 9 V15 M9.5 12.5 L12 15 L14.5 12.5" />
                                            <TextBlock Text="{Binding BackupNowText}" FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Panel>
    </Grid>

</Window>
