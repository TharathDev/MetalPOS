<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PosApp.ViewModels"
        xmlns:models="using:PosApp.Models"
        xmlns:conv="using:PosApp.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="820"
        x:Class="PosApp.Views.MainWindow"
        x:DataType="vm:MaterialSelectionViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1200" Height="820"
        MinWidth="1040" MinHeight="680"
        Background="White"
        Title="METALS_POS - Inventory Manager">

    <Design.DataContext>
        <vm:MaterialSelectionViewModel />
    </Design.DataContext>

    <!-- ================= Resources ================= -->
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#C2410C" />
        <SolidColorBrush x:Key="AccentDark" Color="#9A3412" />
        <SolidColorBrush x:Key="TextPrimary" Color="#1F2937" />
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />
        <SolidColorBrush x:Key="TextFaint" Color="#9CA3AF" />
        <SolidColorBrush x:Key="HairLine" Color="#E5E7EB" />
        <SolidColorBrush x:Key="Danger" Color="#DC2626" />
        <SolidColorBrush x:Key="PeachTile" Color="#FBE3D3" />
        <SolidColorBrush x:Key="BlueTile" Color="#E6ECF4" />
        <SolidColorBrush x:Key="ChipBg" Color="#F3F4F6" />
        <SolidColorBrush x:Key="LavenderPill" Color="#ECEBFB" />
        <SolidColorBrush x:Key="LavenderText" Color="#5B54C9" />

        <!-- Selected dimension row highlight (compares ListBoxItem.IsSelected to True) -->
        <conv:EqualityToBrushConverter x:Key="RowBg" TrueBrush="#FDF3EE" FalseBrush="White" />
        <conv:EqualityToBrushConverter x:Key="RowBorder" TrueBrush="#C2410C" FalseBrush="#E5E7EB" />

        <!-- ===== Input chrome overrides =====
             The stock Fluent theme fills text inputs with a grey wash and uses a
             thick blue focus underline. These keep inputs flat white with square
             corners and an accent focus border, matching the rest of the UI. -->
        <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>

        <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#F3F4F6" />

        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D1D5DB" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#9CA3AF" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#C2410C" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#E5E7EB" />

        <SolidColorBrush x:Key="TextControlForeground" Color="#1F2937" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#1F2937" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#1F2937" />

        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#9CA3AF" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#9CA3AF" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#B6BCC6" />

        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#C2410C" />
        <!-- Fluent thickens the bottom edge on focus; keep it an even 1px box. -->
        <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

        <!-- ComboBox chrome -->
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FAFAFA" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#F3F4F6" />
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#F3F4F6" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D1D5DB" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#9CA3AF" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#C2410C" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#C2410C" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#1F2937" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#FDF3EE" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FBE3D3" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#1F2937" />
    </Window.Resources>

    <!-- ================= Styles ================= -->
    <Window.Styles>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontFamily" Value="Georgia, serif" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontFamily" Value="Georgia, serif" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- Line-icon defaults -->
        <Style Selector="Path.icon">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
        </Style>

        <!-- Sidebar nav buttons -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Accent (primary) buttons -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- Pin the chrome for every state so no theme variant can recolor it. -->
        <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentDark}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentDark}" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E3B9A6" />
        </Style>

        <!-- ===== Smooth interactions: fade hover colors, subtle press + card lift ===== -->
        <!-- All buttons fade their background/border on hover instead of snapping. -->
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.17" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.17" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <!-- Gentle press feedback on the primary/interactive buttons. -->
        <Style Selector="Button.primary, Button.pill, Button.ghost, Button.rowAdd, Button.iconBtn, Button.quickAction">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.11" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pressed, Button.pill:pressed, Button.ghost:pressed, Button.rowAdd:pressed, Button.iconBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>

        <!-- Header pills -->
        <Style Selector="Button.pill">
            <Setter Property="Background" Value="{StaticResource ChipBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E5E7EB" />
        </Style>

        <!-- Category card buttons -->
        <Style Selector="Button.categoryCard">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="MinHeight" Value="228" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.categoryCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFF9F5" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <!-- Cards gently lift on hover for a smooth, tactile feel. -->
        <Style Selector="Button.categoryCard">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.categoryCard:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-3px)" />
        </Style>

        <!-- Quick-action rows -->
        <Style Selector="Button.quickAction">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource HairLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.quickAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FAFAFA" />
        </Style>

        <!-- Transparent button (icon buttons, tab click surface, scrim) -->
        <Style Selector="Button.bare">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <!-- Translucent overlay so it reads on white and on colored (tab) backgrounds. -->
            <Setter Property="Background" Value="#14000000" />
        </Style>

        <!-- Scrim behind the modal (fades in/out) -->
        <Style Selector="Button.scrim">
            <Setter Property="Background" Value="#4D1F2937" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.28" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.scrim.open">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.scrim:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4D1F2937" />
        </Style>

        <!-- Drawer slides in from the right -->
        <Style Selector="Border.drawer">
            <Setter Property="RenderTransform" Value="translateX(520px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.drawer.open">
            <Setter Property="RenderTransform" Value="translateX(0)" />
        </Style>

        <!-- Cart drawer slides in from the left -->
        <Style Selector="Border.drawerLeft">
            <Setter Property="RenderTransform" Value="translateX(-640px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.drawerLeft.open">
            <Setter Property="RenderTransform" Value="translateX(0)" />
        </Style>

        <!-- Small per-row ADD TO CART button -->
        <Style Selector="Button.rowAdd">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Button.rowAdd:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentDark}" />
        </Style>

        <!-- Compact quantity stepper shown once a row is in the cart. Kept visually
             light (outlined, not a solid block) so it doesn't outweigh the row text. -->
        <Style Selector="Button.qtyStep">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.qtyStep:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PeachTile}" />
        </Style>
        <Style Selector="Button.qtyStep:disabled">
            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        </Style>

        <!-- Dimension ListBox: strip default selection chrome so our row Border shows through -->
        <Style Selector="ListBox.dims">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.dims ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBox.dims ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.dims ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Technical documentation links -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Form field label -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Text inputs / combos: flat white, square, accent focus ring -->
        <Style Selector="TextBox.field">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- Style the template border directly so the chrome can't be re-filled
             by theme-variant resources. -->
        <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#9CA3AF" />
        </Style>
        <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="TextBox.field:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style Selector="ComboBox.field">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Secondary (ghost) button -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6" />
        </Style>

        <!-- Small icon action button (edit/delete rows) -->
        <Style Selector="Button.iconBtn">
            <Setter Property="Background" Value="{StaticResource ChipBg}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E5E7EB" />
        </Style>

        <!-- Table header cell -->
        <Style Selector="TextBlock.th">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
    </Window.Styles>

    <!-- ================= Layout ================= -->
    <Grid ColumnDefinitions="248,*">

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,20">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="6,0,0,26">
                    <TextBlock Classes="mono" Text="METALS_POS" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Classes="mono" Text="INVENTORY MANAGER" FontSize="11"
                               Foreground="{StaticResource TextFaint}" />
                </StackPanel>

                <!-- Bottom block: cart button with live item-count badge -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="12">
                    <Border Height="1" Background="{StaticResource HairLine}" Margin="0,0,0,4" />
                    <Button Classes="primary" Command="{Binding ToggleCartDrawerCommand}"
                            ToolTip.Tip="View cart and check out">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Path Grid.Column="0" Classes="icon" Width="18" Height="18" Stroke="White"
                                  Data="M3 4 H5 L7.2 15 H18 L20 7 H6 M8.5 19 a1.2 1.2 0 1 0 0.01 0 M17 19 a1.2 1.2 0 1 0 0.01 0" />
                            <TextBlock Grid.Column="1" Classes="mono" Text="CART" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <!-- Badge showing the number of items currently in the cart -->
                            <Border Grid.Column="2" MinWidth="22" Height="22" CornerRadius="11"
                                    Background="White" IsVisible="{Binding HasCartBadge}"
                                    VerticalAlignment="Center" Padding="6,0">
                                <TextBlock Text="{Binding CartItemCount}" Classes="mono" FontSize="11"
                                           FontWeight="Bold" Foreground="{StaticResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Nav items -->
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <Button Classes="nav" Classes.active="{Binding IsInventorySection}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Inventory">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Width="19" Height="19"
                                  Data="M4 4 H20 V20 H4 Z M4 9 H20 M9 4 V9" />
                            <TextBlock Text="Inventory" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsStockSection}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Stock">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Width="19" Height="19"
                                  Data="M12 3 L20 7 L12 11 L4 7 Z M4 12 L12 16 L20 12 M4 17 L12 21 L20 17" />
                            <TextBlock Text="Stock" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsOrdersSection}"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Orders">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Width="19" Height="19"
                                  Data="M3 4 H5 L7.2 15 H18 L20 7 H6 M8.5 19 a1.2 1.2 0 1 0 0.01 0 M17 19 a1.2 1.2 0 1 0 0.01 0" />
                            <TextBlock Text="Orders" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="Reports">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="icon" Width="19" Height="19"
                                  Data="M4 20 H21 M6 20 V12 M11 20 V5 M16 20 V9" />
                            <TextBlock Text="Reports" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Right of sidebar ===== -->
        <DockPanel Grid.Column="1">

            <!-- Top bar -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,0,1"
                    Padding="24,14">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <!-- Search -->
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource HairLine}"
                            BorderThickness="1" CornerRadius="10" Padding="12,0" MaxWidth="620"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*" Height="42">
                            <Path Grid.Column="0" Classes="icon" Width="17" Height="17" Margin="2,0,10,0"
                                  Data="M10 4 a6 6 0 1 0 0.01 0 M15 15 L20 20" />
                            <TextBox Grid.Column="1" Text="{Binding SearchText}"
                                     PlaceholderText="Search materials, SKU, or categories..."
                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                     VerticalContentAlignment="Center" FontSize="14" Padding="0" />
                        </Grid>
                    </Border>

                    <!-- Bell -->
                    <Panel Grid.Column="1" Margin="22,0,20,0" VerticalAlignment="Center" Width="24" Height="24">
                        <Path Classes="icon" Width="22" Height="22"
                              Data="M12 4 C9 4 8 6 8 9 C8 13 6 15 6 15 H18 C18 15 16 13 16 9 C16 6 15 4 12 4 Z M10 18 a2 2 0 0 0 4 0" />
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Stroke="White" StrokeThickness="1.2"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" />
                    </Panel>

                    <!-- User -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource ChipBg}">
                            <Path Classes="icon" Width="18" Height="18"
                                  Data="M12 8 a3 3 0 1 0 0.01 0 M6 19 a6 6 0 0 1 12 0" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Admin User" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Classes="mono" Text="WAREHOUSE A" FontSize="10"
                                       Foreground="{StaticResource TextFaint}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content: main + optional wide-screen specs panel -->
            <Grid ColumnDefinitions="*,Auto">

                <!-- Main content -->
                <ScrollViewer Grid.Column="0" Padding="28,24" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Header row -->
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Top">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Classes="h1" Text="{Binding SectionTitle}" />
                                <TextBlock Text="{Binding SectionSubtitle}"
                                           FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                           MaxWidth="460" HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                                <Button Classes="pill" Command="{Binding BackupNowCommand}"
                                        ToolTip.Tip="{Binding BackupStatus}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="icon" Width="15" Height="15"
                                              Data="M6 16 a4 4 0 0 1 1 -7.9 A5 5 0 0 1 17 8 a3.5 3.5 0 0 1 -0.5 7 H7 M12 9 V15 M9.5 12.5 L12 15 L14.5 12.5" />
                                        <TextBlock Classes="mono" Text="{Binding SyncLabel}" FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="pill" Background="{StaticResource LavenderPill}"
                                        Foreground="{StaticResource LavenderText}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource LavenderText}"
                                              Data="M13 3 L6 14 H11 L10 21 L18 9 H13 Z" />
                                        <TextBlock Classes="mono" Text="LIVE INVENTORY" FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ============ INVENTORY SECTION ============ -->
                        <StackPanel IsVisible="{Binding IsInventorySection}" Margin="0,24,0,0">
                            <ListBox ItemsSource="{Binding Categories}" Margin="-8,-8,-8,0"
                                     VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <!-- ListBoxItem is a concrete container, allowing every generated
                                     tile to fill its equal-width UniformGrid cell exactly. -->
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Top" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding CategoryColumns}"
                                                     Rows="0" VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:CategoryInfo">
                                        <Grid>
                                            <!-- Standard category tile -->
                                            <Button Classes="categoryCard" Margin="8" Height="200"
                                                    Width="{Binding CardWidth}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    IsVisible="{Binding !IsCustom}"
                                                    Command="{Binding $parent[ListBox].((vm:MaterialSelectionViewModel)DataContext).SelectCategoryCommand}"
                                                    CommandParameter="{Binding Name}">
                                                <Grid RowDefinitions="Auto,*,Auto">
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                                        <Border Width="52" Height="52" CornerRadius="12"
                                                                Background="{StaticResource PeachTile}">
                                                            <Path Classes="icon" Width="24" Height="24"
                                                                  Stroke="{StaticResource Accent}"
                                                                  Data="M12 3 L20 7 L12 11 L4 7 Z M4 12 L12 16 L20 12 M4 17 L12 21 L20 17" />
                                                        </Border>
                                                        <Border Grid.Column="2" VerticalAlignment="Top"
                                                                Background="{StaticResource ChipBg}"
                                                                CornerRadius="6" Padding="8,4">
                                                            <TextBlock Classes="mono" Text="{Binding SkuLabel}" FontSize="11"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,0">
                                                        <TextBlock Classes="cardTitle" Text="{Binding Name}" />
                                                        <TextBlock Text="{Binding Description}" FontSize="13"
                                                                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border Grid.Row="2" BorderBrush="{StaticResource HairLine}"
                                                            BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,14,0,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Path Classes="icon" Width="15" Height="15"
                                                                  Data="M4 12 H10 V20 H4 Z M14 4 H20 V20 H14 Z" />
                                                            <TextBlock Text="{Binding StockLine}" FontSize="12"
                                                                       Foreground="{StaticResource TextMuted}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <!-- Custom object action occupies a normal grid cell. -->
                                            <Button Classes="categoryCard" Margin="8" Height="200"
                                                    Width="{Binding CardWidth}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    IsVisible="{Binding IsCustom}"
                                                    Background="Transparent" BorderThickness="0" Padding="0"
                                                    Command="{Binding $parent[ListBox].((vm:MaterialSelectionViewModel)DataContext).AddCustomCategoryCommand}">
                                                <Grid>
                                                    <Rectangle RadiusX="12" RadiusY="12" Fill="#F8F8F9"
                                                               Stroke="#D1D5DB" StrokeThickness="1.5"
                                                               StrokeDashArray="4,3" />
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                Spacing="12" Margin="20">
                                                        <Border Width="48" Height="48" CornerRadius="12" Background="White"
                                                                BorderBrush="{StaticResource HairLine}" BorderThickness="1">
                                                            <Path Classes="icon" Width="20" Height="20"
                                                                  Stroke="{StaticResource TextMuted}"
                                                                  Data="M12 5 V19 M5 12 H19" />
                                                        </Border>
                                                        <TextBlock Text="Add Custom Object" FontSize="14"
                                                                   FontWeight="SemiBold" TextAlignment="Center"
                                                                   Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- ============ STOCK MANAGEMENT SECTION ============ -->
                        <StackPanel IsVisible="{Binding IsStockSection}" Margin="0,22,0,0" Spacing="14">

                            <!-- Toolbar: status + add button -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="{Binding StockStatus}" FontSize="13"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="2,0,12,0" />
                                <Button Grid.Column="1" Classes="primary" Padding="14,10"
                                        Command="{Binding OpenAddProductCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="icon" Width="16" Height="16" Stroke="White"
                                              Data="M12 5 V19 M5 12 H19" />
                                        <TextBlock Classes="mono" Text="ADD ITEM" FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Stock table -->
                            <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                    CornerRadius="12" Padding="0">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,90,70,80,84"
                                          Background="#FAFAFA" Height="40">
                                        <TextBlock Classes="th" Text="ITEM" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <TextBlock Grid.Column="1" Classes="th" Text="PRICE" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="th" Text="STOCK" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Classes="th" Text="SKU" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Classes="th" Text="ACTIONS" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
                                        <ItemsControl ItemsSource="{Binding StockItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:Product">
                                                    <Border BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,0,1"
                                                            Padding="14,10">
                                                        <Grid ColumnDefinitions="*,90,70,80,84" VerticalAlignment="Center">
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextPrimary}" />
                                                                <TextBlock Text="{Binding CategoryDimensionLine}"
                                                                           FontSize="12"
                                                                           Foreground="{StaticResource TextMuted}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding PriceLabel}"
                                                                       FontSize="13" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding StockDisplay}"
                                                                       FontSize="13" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding SkuDisplay}"
                                                                       FontSize="11" VerticalAlignment="Center"
                                                                       Classes="mono"
                                                                       Foreground="{StaticResource TextFaint}" />
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                                                        VerticalAlignment="Center">
                                                                <Button Classes="iconBtn"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).EditProductRowCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Path Classes="icon" Width="15" Height="15"
                                                                          Data="M4 20 L4 16 L15 5 L19 9 L8 20 Z M13 7 L17 11" />
                                                                </Button>
                                                                <Button Classes="iconBtn"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).DeleteProductRowCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Path Classes="icon" Width="15" Height="15"
                                                                          Stroke="{StaticResource Danger}"
                                                                          Data="M5 7 H19 M9 7 V5 H15 V7 M7 7 L8 20 H16 L17 7" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                        </StackPanel>

                        <!-- ============ CHECKOUT SECTION ============ -->
                        <Grid IsVisible="{Binding IsCheckoutSection}" Margin="0,22,0,0"
                              ColumnDefinitions="*,360" ColumnSpacing="20">

                            <!-- Left: verify line items -->
                            <StackPanel Grid.Column="0" Spacing="12">
                                <!-- Customer details: compact and kept above the item list so a
                                     long list can grow and scroll underneath it.
                                     Printed on the receipt only - never stored in the database. -->
                                <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                        CornerRadius="12" Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="Customer Details" FontSize="14"
                                                       FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                       Text="Optional - receipt only, not saved"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextFaint}" />
                                        </Grid>
                                        <!-- Name / phone / address on one row keeps this panel short -->
                                        <Grid ColumnDefinitions="*,150,*" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Classes="fieldLabel" Text="NAME" Margin="0" />
                                                <TextBox Classes="field" Padding="8,6" FontSize="13"
                                                         Text="{Binding CustomerName}"
                                                         PlaceholderText="Walk-in Customer" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Classes="fieldLabel" Text="PHONE" Margin="0" />
                                                <TextBox Classes="field" Padding="8,6" FontSize="13"
                                                         Text="{Binding CustomerPhone}"
                                                         PlaceholderText="optional" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Classes="fieldLabel" Text="ADDRESS" Margin="0" />
                                                <TextBox Classes="field" Padding="8,6" FontSize="13"
                                                         Text="{Binding CustomerAddress}"
                                                         PlaceholderText="optional" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="fieldLabel" Text="ORDER NOTE" Margin="0" />
                                            <TextBox Classes="field" Padding="8,6" FontSize="13"
                                                     Text="{Binding OrderNote}"
                                                     PlaceholderText="Cutting instructions, delivery notes, etc." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Item list last: it takes the remaining height and scrolls -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Review Items" FontFamily="Georgia, serif"
                                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <Button Grid.Column="1" Classes="ghost" Command="{Binding BackToShoppingCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="icon" Width="15" Height="15" Data="M15 6 L9 12 L15 18" />
                                            <TextBlock Text="Continue Shopping" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1" CornerRadius="12">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,132,120,96"
                                              Background="#FAFAFA" Height="40">
                                            <TextBlock Classes="th" Text="ITEM" VerticalAlignment="Center" Margin="14,0,0,0" />
                                            <TextBlock Grid.Column="1" Classes="th" Text="QTY" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="th" Text="UNIT PRICE" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Classes="th" Text="TOTAL" VerticalAlignment="Center" />
                                        </Grid>
                                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" />
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="560">
                                            <ItemsControl ItemsSource="{Binding Cart}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:CartLine">
                                                        <Border BorderBrush="{StaticResource HairLine}"
                                                                BorderThickness="0,0,0,1" Padding="14,12">
                                                            <Grid ColumnDefinitions="*,132,120,96" VerticalAlignment="Center">
                                                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding Material}" FontSize="13"
                                                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                                                               Foreground="{StaticResource TextPrimary}" />
                                                                    <TextBlock Text="{Binding DimensionDisplay}" FontSize="12"
                                                                               Foreground="{StaticResource TextMuted}" />
                                                                </StackPanel>

                                                                <!-- Adjust quantity -->
                                                                <Border Grid.Column="1" BorderThickness="1"
                                                                        BorderBrush="{StaticResource Accent}"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Button Classes="qtyStep" Content="−"
                                                                                Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).DecrementLineCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                        <TextBlock Text="{Binding Quantity}" Classes="mono"
                                                                                   Width="30" FontSize="13" FontWeight="Bold"
                                                                                   TextAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource TextPrimary}" />
                                                                        <Button Classes="qtyStep" Content="+"
                                                                                Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).IncrementLineCommand}"
                                                                                CommandParameter="{Binding}" />
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Adjust unit price -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                            Spacing="5" VerticalAlignment="Center">
                                                                    <TextBlock Text="$" FontSize="13"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextMuted}" />
                                                                    <TextBox Classes="field" Width="80" Padding="6,6"
                                                                             Text="{Binding UnitPrice}" />
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="3" Text="{Binding LineTotalLabel}"
                                                                           FontSize="14" FontWeight="Bold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextPrimary}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                            </StackPanel>

                            <!-- Right: payment summary -->
                            <Border Grid.Column="1" BorderBrush="{StaticResource HairLine}" BorderThickness="1"
                                    CornerRadius="12" Padding="18" VerticalAlignment="Top">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Payment Summary" FontFamily="Georgia, serif" FontSize="18"
                                               FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Subtotal" FontSize="13"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SubtotalLabel}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <TextBlock Classes="fieldLabel" Text="DISCOUNT ($)" />
                                            <TextBox Classes="field" Text="{Binding DiscountText}" PlaceholderText="0.00" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Classes="fieldLabel" Text="TAX (%)" />
                                            <TextBox Classes="field" Text="{Binding TaxRateText}" PlaceholderText="0" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource HairLine}" />

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Discount" FontSize="13"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DiscountLabel}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Tax" FontSize="13"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding TaxLabel}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </Grid>

                                    <Border Height="2" Background="{StaticResource TextPrimary}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="TOTAL" Classes="mono" FontSize="13"
                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding GrandTotalLabel}" FontSize="24"
                                                   FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                    </Grid>

                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="fieldLabel" Text="PAYMENT METHOD" />
                                        <ComboBox Classes="field" ItemsSource="{Binding PaymentMethods}"
                                                  SelectedItem="{Binding PaymentMethod}" />
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="fieldLabel" Text="AMOUNT PAID" />
                                        <TextBox Classes="field" Text="{Binding AmountPaidText}"
                                                 PlaceholderText="exact amount" />
                                    </StackPanel>

                                    <Border Background="{StaticResource ChipBg}" CornerRadius="8" Padding="12,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Change due" FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ChangeLabel}" FontSize="15"
                                                       FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                        </Grid>
                                    </Border>

                                    <Button Classes="primary" CornerRadius="0" HorizontalAlignment="Stretch"
                                            Padding="12,14" Command="{Binding CompleteSaleCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                            <Path Classes="icon" Width="17" Height="17" Stroke="White"
                                                  Data="M5 12 L10 17 L19 7" />
                                            <TextBlock Text="Complete Sale &amp; Print" FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{Binding CheckoutStatus}" FontSize="12" TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource Danger}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ============ ORDER COMPLETED SECTION ============ -->
                        <Grid IsVisible="{Binding IsCompleteSection}" Margin="0,22,0,0">
                            <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1" CornerRadius="12"
                                    MaxWidth="660" HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Background="White">
                                <StackPanel>
                                    <!-- Success banner -->
                                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="0,0,0,1"
                                            CornerRadius="12,12,0,0" Padding="24,22">
                                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                                            <Border Width="56" Height="56" CornerRadius="28" Background="#16A34A"
                                                    HorizontalAlignment="Center">
                                                <Path Width="30" Height="30" Stroke="White" StrokeThickness="2.6"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      Data="M5 12 L10 17 L19 7" />
                                            </Border>
                                            <TextBlock Text="Order Completed" FontFamily="Georgia, serif"
                                                       FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                                                       Foreground="#14532D" />
                                            <TextBlock FontSize="13" HorizontalAlignment="Center"
                                                       Foreground="#166534">
                                                <Run Text="Sale" />
                                                <Run Text="{Binding CompletedSaleNumber}" FontWeight="Bold" />
                                                <Run Text="·" />
                                                <Run Text="{Binding CompletedItemSummary}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding CompletedTimestamp}" FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextMuted}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Customer -->
                                    <StackPanel Margin="24,18,24,0" Spacing="3">
                                        <TextBlock Classes="mono" Text="CUSTOMER" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding CompletedCustomer}" FontSize="15"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding CompletedContact}" FontSize="12"
                                                   IsVisible="{Binding CompletedHasContact}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>

                                    <!-- Items sold -->
                                    <StackPanel Margin="24,16,24,0" Spacing="6">
                                        <TextBlock Classes="mono" Text="ITEMS" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1">
                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="240">
                                                <ItemsControl ItemsSource="{Binding CompletedLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:CartLine">
                                                            <Border BorderBrush="{StaticResource HairLine}"
                                                                    BorderThickness="0,0,0,1" Padding="12,9">
                                                                <Grid ColumnDefinitions="*,54,90,84">
                                                                    <StackPanel Grid.Column="0" Spacing="1"
                                                                                Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding Material}" FontSize="13"
                                                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                                                   Foreground="{StaticResource TextPrimary}" />
                                                                        <TextBlock Text="{Binding DimensionDisplay}"
                                                                                   FontSize="11"
                                                                                   Foreground="{StaticResource TextMuted}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity}"
                                                                               Classes="mono" FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               TextAlignment="Center"
                                                                               Foreground="{StaticResource TextMuted}" />
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding UnitPriceLabel}"
                                                                               FontSize="12" VerticalAlignment="Center"
                                                                               TextAlignment="Right"
                                                                               Foreground="{StaticResource TextMuted}" />
                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding LineTotalLabel}"
                                                                               FontSize="13" FontWeight="Bold"
                                                                               VerticalAlignment="Center"
                                                                               TextAlignment="Right"
                                                                               Foreground="{StaticResource TextPrimary}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>

                                    <!-- Totals -->
                                    <StackPanel Margin="24,16,24,0" Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Subtotal" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CompletedSubtotalLabel}"
                                                       FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CompletedHasDiscount}">
                                            <TextBlock Grid.Column="0" Text="Discount" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CompletedDiscountLabel}"
                                                       FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CompletedHasTax}">
                                            <TextBlock Grid.Column="0" Text="Tax" FontSize="13"
                                                       Foreground="{StaticResource TextMuted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CompletedTaxLabel}"
                                                       FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                        </Grid>
                                        <Border Height="2" Background="{StaticResource TextPrimary}" Margin="0,4,0,2" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Classes="mono" Text="TOTAL PAID" FontSize="13"
                                                       FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CompletedTotalLabel}"
                                                       FontSize="26" FontWeight="Bold"
                                                       Foreground="{StaticResource Accent}" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Payment breakdown -->
                                    <Border Margin="24,14,24,0" Background="{StaticResource ChipBg}" Padding="14,12">
                                        <Grid ColumnDefinitions="*,*,*">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Classes="mono" Text="METHOD" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Text="{Binding CompletedPaymentLabel}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Classes="mono" Text="PAID" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Text="{Binding CompletedPaidLabel}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Classes="mono" Text="CHANGE" FontSize="10"
                                                           Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Text="{Binding CompletedChangeLabel}" FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource Accent}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Note -->
                                    <StackPanel Margin="24,14,24,0" Spacing="3"
                                                IsVisible="{Binding CompletedHasNote}">
                                        <TextBlock Classes="mono" Text="NOTE" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding CompletedNote}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>

                                    <!-- Receipt reprint -->
                                    <Button Classes="link" Margin="24,14,24,0"
                                            HorizontalAlignment="Center"
                                            Command="{Binding ReprintReceiptCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="icon" Width="15" Height="15" Stroke="{StaticResource Accent}"
                                                  Data="M7 8 V4 H17 V8 M7 17 H5 V10 H19 V17 H17 M7 14 H17 V20 H7 Z" />
                                            <TextBlock Text="Print receipt again" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Accent}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Actions -->
                                    <Grid Margin="24,18,24,22" ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <Button Grid.Column="0" Classes="ghost" Padding="12,14"
                                                Command="{Binding StartNewOrderCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        HorizontalAlignment="Center">
                                                <Path Classes="icon" Width="16" Height="16"
                                                      Data="M12 5 V19 M5 12 H19" />
                                                <TextBlock Text="New Order" FontWeight="Bold"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="primary" Padding="12,14"
                                                Command="{Binding AcknowledgeCompleteCommand}">
                                            <TextBlock Text="OK" FontWeight="Bold" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ============ ORDERS / HISTORY SECTION ============ -->
                        <StackPanel IsVisible="{Binding IsOrdersSection}" Margin="0,22,0,0" Spacing="12">
                            <Grid ColumnDefinitions="*,300" ColumnSpacing="12">
                                <Border Grid.Column="0" Background="{StaticResource ChipBg}" CornerRadius="10"
                                        Padding="16,12">
                                    <TextBlock Text="{Binding OrdersSummary}" FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}" />
                                </Border>
                                <TextBox Grid.Column="1" Classes="field" Text="{Binding OrderSearchText}"
                                         VerticalAlignment="Center"
                                         PlaceholderText="Search receipt no or customer" />
                            </Grid>
                            <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1" CornerRadius="12">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="140,120,*,90,110,140"
                                          Background="#FAFAFA" Height="40">
                                        <TextBlock Classes="th" Text="RECEIPT NO" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <TextBlock Grid.Column="1" Classes="th" Text="DATE" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="th" Text="CUSTOMER" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Classes="th" Text="ITEMS" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Classes="th" Text="TOTAL" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Classes="th" Text="ACTIONS" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="540">
                                        <ItemsControl ItemsSource="{Binding RecentSales}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:Sale">
                                                    <Border BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,0,1"
                                                            Padding="14,11">
                                                        <Grid ColumnDefinitions="140,120,*,90,110,140"
                                                              VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ReceiptNoDisplay}" Classes="mono"
                                                                       FontSize="13" FontWeight="Bold"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Accent}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DateDisplay}"
                                                                       FontSize="13" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding CustomerDisplay}"
                                                                       FontSize="13" VerticalAlignment="Center"
                                                                       Margin="0,0,10,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding ItemCountDisplay}"
                                                                       FontSize="13" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                            <TextBlock Grid.Column="4" Text="{Binding TotalDisplay}"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                                        Spacing="6" VerticalAlignment="Center">
                                                                <Button Classes="ghost" Padding="10,6"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).OpenOrderDetailCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock Text="View" FontSize="12" />
                                                                </Button>
                                                                <Button Classes="iconBtn"
                                                                        ToolTip.Tip="Print receipt"
                                                                        Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).PrintOrderCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Path Classes="icon" Width="15" Height="15"
                                                                          Data="M7 8 V4 H17 V8 M7 17 H5 V10 H19 V17 H17 M7 14 H17 V20 H7 Z" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Technical specs use an auto-width column and collapse outside wide Inventory. -->
                <Border Grid.Column="1" Width="300"
                        IsVisible="{Binding IsTechnicalPanelVisible}"
                        BorderBrush="{StaticResource HairLine}" BorderThickness="1,0,0,0">
                    <DockPanel Margin="20,24">
                        <!-- Add to cart pinned bottom -->
                        <Button DockPanel.Dock="Bottom" Classes="primary" Command="{Binding AddToCartCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Path Classes="icon" Width="18" Height="18" Stroke="White"
                                      Data="M3 4 H5 L7.2 15 H18 L20 7 H6 M8.5 19 a1.2 1.2 0 1 0 0.01 0 M17 19 a1.2 1.2 0 1 0 0.01 0" />
                                <TextBlock Classes="mono" Text="ADD TO CART" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Classes="mono" Text="MATERIAL SPECS" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding DetailSubtitle}" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" Margin="0,6,0,16" />

                            <!-- Placeholder box -->
                            <Border Background="#F7F7F8" CornerRadius="10" Padding="18" Height="180">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="White"
                                            BorderBrush="{StaticResource HairLine}" BorderThickness="1">
                                        <Path Classes="icon" Width="20" Height="20"
                                              Data="M12 5 a7 7 0 1 0 0.01 0 M12 11 V16 M12 8 h0.01" />
                                    </Border>
                                    <TextBlock Text="Live Technical Specifications and Dimension Calculator will appear here."
                                               FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="200"
                                               Foreground="{StaticResource TextMuted}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Classes="mono" Text="QUICK ACTIONS" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,24,0,10" />

                            <Button Classes="quickAction" Command="{Binding OpenHistoryCommand}" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Grid.Column="0" Classes="icon" Width="18" Height="18"
                                          Data="M12 6 a6 6 0 1 0 0.01 0 M12 8 V12 L15 14 M4 8 L6.5 6.5" />
                                    <TextBlock Grid.Column="1" Text="History" Margin="12,0,0,0" VerticalAlignment="Center"
                                               FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                    <Path Grid.Column="2" Classes="icon" Width="16" Height="16" Data="M9 6 L15 12 L9 18" />
                                </Grid>
                            </Button>

                            <Button Classes="quickAction" Command="{Binding OpenShipmentsCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Grid.Column="0" Classes="icon" Width="18" Height="18"
                                          Data="M3 6 H15 V16 H3 Z M15 9 H19 L21 12 V16 H15 M6.5 18 a1.5 1.5 0 1 0 0.01 0 M17 18 a1.5 1.5 0 1 0 0.01 0" />
                                    <TextBlock Grid.Column="1" Text="Shipments" Margin="12,0,0,0" VerticalAlignment="Center"
                                               FontSize="14" Foreground="{StaticResource TextPrimary}" />
                                    <Path Grid.Column="2" Classes="icon" Width="16" Height="16" Data="M9 6 L15 12 L9 18" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- ===== Modal drawer: Select Dimensions ===== -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" IsHitTestVisible="{Binding IsDetailOpen}"
               ClipToBounds="True">
            <!-- Scrim (click to close) -->
            <Button Classes="scrim" Classes.open="{Binding IsDetailOpen}"
                    Command="{Binding CloseDetailCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Drawer -->
            <Border Classes="drawer" Classes.open="{Binding IsDetailOpen}"
                    Width="480" HorizontalAlignment="Right" Background="White"
                    BorderBrush="{StaticResource HairLine}" BorderThickness="1,0,0,0"
                    BoxShadow="-8 0 30 0 #1A000000">
                <DockPanel Margin="0">
                    <!-- Header -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,20,0">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="mono" Text="MATERIAL SPECS" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" />
                            <TextBlock Text="Select Dimensions" FontFamily="Georgia, serif" FontSize="22"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding DetailMaterialName}" FontSize="13"
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="bare" VerticalAlignment="Top"
                                Command="{Binding CloseDetailCommand}" Width="30" Height="30">
                            <Path Classes="icon" Width="16" Height="16" Data="M6 6 L18 18 M18 6 L6 18" />
                        </Button>
                    </Grid>

                    <!-- Section label (the cart itself now lives in the left drawer) -->
                    <Border DockPanel.Dock="Top" Margin="24,18,24,0"
                            Background="{StaticResource Accent}" HorizontalAlignment="Left" Padding="18,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="icon" Width="15" Height="15" Stroke="White"
                                  Data="M5 12 L10 17 L19 7" />
                            <TextBlock Classes="mono" Text="Selection" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="White" />
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" Margin="0,16,0,0" />

                    <!-- Bottom action bar -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HairLine}" BorderThickness="0,1,0,0"
                            Padding="24,16">
                        <Button Classes="primary" CornerRadius="0" HorizontalAlignment="Stretch"
                                Command="{Binding AddSelectedToCartCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Path Classes="icon" Width="17" Height="17" Stroke="White"
                                      Data="M3 4 H5 L7.2 15 H18 L20 7 H6 M8.5 19 a1.2 1.2 0 1 0 0.01 0 M17 19 a1.2 1.2 0 1 0 0.01 0" />
                                <TextBlock Text="Add to Cart" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Body -->
                    <Grid Margin="24,18,24,0">
                        <!-- Product selection list -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ListBox Classes="dims" ItemsSource="{Binding CategoryProducts}"
                                         SelectedItem="{Binding SelectedProduct}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Product">
                                            <Border CornerRadius="0" BorderThickness="1" Padding="12"
                                                    Background="{Binding $parent[ListBoxItem].IsSelected, Converter={StaticResource RowBg}, ConverterParameter=True}"
                                                    BorderBrush="{Binding $parent[ListBoxItem].IsSelected, Converter={StaticResource RowBorder}, ConverterParameter=True}">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" >
                                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="0"
                                                            Background="{StaticResource ChipBg}" VerticalAlignment="Center">
                                                        <Path Classes="icon" Width="22" Height="22"
                                                              Data="M4 9 H20 M4 9 L6 6 H18 L20 9 M4 9 V16 H20 V9 M9 9 V16 M14 9 V16" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Dimension}" FontSize="14"
                                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock Text="{Binding StockLabel}" FontSize="12"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding PriceLabel}" FontSize="14"
                                                               FontWeight="Bold" Foreground="{StaticResource TextPrimary}"
                                                               VerticalAlignment="Center" Margin="10,0,14,0" />
                                                    <Panel Grid.Column="3" MinWidth="96" VerticalAlignment="Center">
                                                        <!-- Before adding: standard action. -->
                                                        <Button Classes="rowAdd" HorizontalAlignment="Right"
                                                                IsVisible="{Binding !IsInCart}"
                                                                Command="{Binding $parent[ListBox].((vm:MaterialSelectionViewModel)DataContext).AddProductToCartCommand}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Classes="mono" Text="ADD TO CART" FontSize="10"
                                                                       FontWeight="Bold" />
                                                        </Button>

                                                        <!-- In cart: swap the label for a light inline stepper. -->
                                                        <Border IsVisible="{Binding IsInCart}" HorizontalAlignment="Right"
                                                                Background="White" BorderThickness="1"
                                                                BorderBrush="{StaticResource Accent}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Classes="qtyStep" Content="−"
                                                                        Command="{Binding $parent[ListBox].((vm:MaterialSelectionViewModel)DataContext).DecrementProductQuantityCommand}"
                                                                        CommandParameter="{Binding}" />
                                                                <TextBlock Text="{Binding CartQuantity}" Classes="mono"
                                                                           Width="30" FontSize="13" FontWeight="Bold"
                                                                           TextAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextPrimary}" />
                                                                <Button Classes="qtyStep" Content="+"
                                                                        IsEnabled="{Binding CanIncrease}"
                                                                        Command="{Binding $parent[ListBox].((vm:MaterialSelectionViewModel)DataContext).IncrementProductQuantityCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Panel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Technical documentation -->
                                <TextBlock Classes="mono" Text="TECHNICAL DOCUMENTATION" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" Margin="2,12,0,10" />
                                <Button Classes="link" Command="{Binding OpenDocumentCommand}"
                                        CommandParameter="{Binding DocSheetLabel}" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource Accent}"
                                              Data="M7 3 H14 L18 7 V21 H7 Z M14 3 V7 H18 M9.5 12 H15 M9.5 15.5 H15" />
                                        <TextBlock Text="{Binding DocSheetLabel}" FontSize="13"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="link" Command="{Binding OpenDocumentCommand}"
                                        CommandParameter="Certification of Compliance">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Classes="icon" Width="16" Height="16" Stroke="{StaticResource Accent}"
                                              Data="M12 4 a5 5 0 1 0 0.01 0 M9.5 12 L11.5 14 L15 10" />
                                        <TextBlock Text="Certification of Compliance" FontSize="13"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Panel>

        <!-- ===== Modal drawer: Add / Edit Stock Item ===== -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" IsHitTestVisible="{Binding IsStockFormOpen}"
               ClipToBounds="True">
            <!-- Scrim (click to close) -->
            <Button Classes="scrim" Classes.open="{Binding IsStockFormOpen}"
                    Command="{Binding CloseStockFormCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Drawer -->
            <Border Classes="drawer" Classes.open="{Binding IsStockFormOpen}"
                    Width="440" HorizontalAlignment="Right" Background="White"
                    BorderBrush="{StaticResource HairLine}" BorderThickness="1,0,0,0"
                    BoxShadow="-8 0 30 0 #1A000000">
                <DockPanel>
                    <!-- Header -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,22,20,0">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="mono" Text="INVENTORY" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" />
                            <TextBlock Text="{Binding FormTitle}" FontFamily="Georgia, serif" FontSize="22"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="bare" VerticalAlignment="Top"
                                Command="{Binding CloseStockFormCommand}" Width="30" Height="30">
                            <Path Classes="icon" Width="16" Height="16" Data="M6 6 L18 18 M18 6 L6 18" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}" Margin="0,16,0,0" />

                    <!-- Footer actions -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HairLine}" BorderThickness="0,1,0,0"
                            Padding="24,16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding StockStatus}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Button Grid.Column="0" Classes="primary" Padding="12,12"
                                        Command="{Binding SaveProductCommand}"
                                        Content="{Binding SaveButtonLabel}" />
                                <Button Grid.Column="1" Classes="ghost" Command="{Binding NewProductCommand}"
                                        Content="Clear" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Body: form fields -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="24,18,24,0">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="fieldLabel" Text="CATEGORY" />
                                <TextBox Classes="field" Text="{Binding FormCategory}"
                                         PlaceholderText="e.g. Steel, Copper, Aluminium" />
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock Classes="fieldLabel" Text="MATERIAL / NAME" />
                                <TextBox Classes="field" Text="{Binding FormName}"
                                         PlaceholderText="e.g. Alloy Steel Grade A36" />
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock Classes="fieldLabel" Text="DIMENSION / SPEC" />
                                <TextBox Classes="field" Text="{Binding FormDimension}"
                                         PlaceholderText="e.g. 2&quot; x 4&quot;" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Classes="fieldLabel" Text="UNIT" />
                                    <ComboBox Classes="field" ItemsSource="{Binding Units}"
                                              SelectedItem="{Binding FormUnit}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Classes="fieldLabel" Text="SKU" />
                                    <TextBox Classes="field" Text="{Binding FormSku}" PlaceholderText="optional" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Classes="fieldLabel" Text="PRICE" />
                                    <TextBox Classes="field" Text="{Binding FormPriceText}" PlaceholderText="0.00" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Classes="fieldLabel" Text="STOCK QTY" />
                                    <TextBox Classes="field" Text="{Binding FormStockText}" PlaceholderText="0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- ===== Right drawer: stored order detail + reprint ===== -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" IsHitTestVisible="{Binding IsOrderDetailOpen}"
               ClipToBounds="True">
            <Button Classes="scrim" Classes.open="{Binding IsOrderDetailOpen}"
                    Command="{Binding CloseOrderDetailCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Border Classes="drawer" Classes.open="{Binding IsOrderDetailOpen}"
                    Width="470" HorizontalAlignment="Right" Background="White"
                    BorderBrush="{StaticResource HairLine}" BorderThickness="1,0,0,0"
                    BoxShadow="-8 0 30 0 #1A000000">
                <DockPanel DataContext="{Binding SelectedOrder}">
                    <!-- Header -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="22,22,18,0">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="mono" Text="RECEIPT NO" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" />
                            <TextBlock Classes="mono" Text="{Binding ReceiptNoDisplay}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" />
                            <TextBlock Text="{Binding TimestampDisplay}" FontSize="12"
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="bare" VerticalAlignment="Top" Width="30" Height="30"
                                Command="{Binding $parent[Window].((vm:MaterialSelectionViewModel)DataContext).CloseOrderDetailCommand}">
                            <Path Classes="icon" Width="16" Height="16" Data="M6 6 L18 18 M18 6 L6 18" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}"
                            Margin="0,16,0,0" />

                    <!-- Reprint action -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HairLine}"
                            BorderThickness="0,1,0,0" Padding="22,16">
                        <StackPanel Spacing="10">
                            <Button Classes="primary" HorizontalAlignment="Stretch" Padding="12,13"
                                    Command="{Binding $parent[Window].((vm:MaterialSelectionViewModel)DataContext).PrintSelectedOrderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <Path Classes="icon" Width="17" Height="17" Stroke="White"
                                          Data="M7 8 V4 H17 V8 M7 17 H5 V10 H19 V17 H17 M7 14 H17 V20 H7 Z" />
                                    <TextBlock Text="Print Receipt" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding $parent[Window].((vm:MaterialSelectionViewModel)DataContext).OrderDetailStatus}"
                                       FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </Border>

                    <!-- Body -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="22,16,22,0">
                        <StackPanel Spacing="14">
                            <!-- Customer -->
                            <StackPanel Spacing="3">
                                <TextBlock Classes="mono" Text="CUSTOMER" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding CustomerDisplay}" FontSize="14" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding ContactDisplay}" FontSize="12" TextWrapping="Wrap"
                                           IsVisible="{Binding HasContact}"
                                           Foreground="{StaticResource TextMuted}" />
                            </StackPanel>

                            <!-- Items -->
                            <StackPanel Spacing="6">
                                <TextBlock Classes="mono" Text="ITEMS" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" />
                                <Border BorderBrush="{StaticResource HairLine}" BorderThickness="1">
                                    <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MaterialSelectionViewModel)DataContext).SelectedOrderItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SaleItem">
                                                <Border BorderBrush="{StaticResource HairLine}"
                                                        BorderThickness="0,0,0,1" Padding="12,9">
                                                    <Grid ColumnDefinitions="*,44,84,84">
                                                        <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Material}" FontSize="13"
                                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <TextBlock Text="{Binding DimensionDisplay}" FontSize="11"
                                                                       Foreground="{StaticResource TextMuted}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}"
                                                                   Classes="mono" FontSize="12" TextAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding UnitPriceDisplay}"
                                                                   FontSize="12" TextAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding LineTotalDisplay}"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextPrimary}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- Money breakdown -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Subtotal" FontSize="13"
                                               Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SubtotalDisplay}" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasDiscount}">
                                    <TextBlock Grid.Column="0" Text="Discount" FontSize="13"
                                               Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DiscountDisplay}" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasTax}">
                                    <TextBlock Grid.Column="0" Text="Tax" FontSize="13"
                                               Foreground="{StaticResource TextMuted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TaxDisplay}" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}" />
                                </Grid>
                                <Border Height="2" Background="{StaticResource TextPrimary}" Margin="0,4,0,2" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="mono" Text="TOTAL" FontSize="13"
                                               FontWeight="Bold" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalDisplay}" FontSize="22"
                                               FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                </Grid>
                            </StackPanel>

                            <!-- Payment -->
                            <Border Background="{StaticResource ChipBg}" Padding="14,12">
                                <Grid ColumnDefinitions="*,*,*">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Classes="mono" Text="METHOD" FontSize="10"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding PaymentMethod}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Classes="mono" Text="PAID" FontSize="10"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding AmountPaidDisplay}" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Classes="mono" Text="CHANGE" FontSize="10"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding ChangeDueDisplay}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource Accent}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Note -->
                            <StackPanel Spacing="3" IsVisible="{Binding HasNote}">
                                <TextBlock Classes="mono" Text="NOTE" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- ===== Left drawer: Cart + Checkout (3/10 of the window width) ===== -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2" IsHitTestVisible="{Binding IsCartDrawerOpen}"
               ClipToBounds="True">
            <!-- Scrim (click to close) -->
            <Button Classes="scrim" Classes.open="{Binding IsCartDrawerOpen}"
                    Command="{Binding CloseCartDrawerCommand}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <Border Classes="drawerLeft" Classes.open="{Binding IsCartDrawerOpen}"
                    Width="{Binding CartDrawerWidth}" HorizontalAlignment="Left" Background="White"
                    BorderBrush="{StaticResource HairLine}" BorderThickness="0,0,1,0"
                    BoxShadow="8 0 30 0 #1A000000">
                <DockPanel>
                    <!-- Header -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="22,22,18,0">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="mono" Text="CURRENT SALE" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" />
                            <TextBlock Text="Cart" FontFamily="Georgia, serif" FontSize="22"
                                       FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="bare" VerticalAlignment="Top"
                                Command="{Binding CloseCartDrawerCommand}" Width="30" Height="30">
                            <Path Classes="icon" Width="16" Height="16" Data="M6 6 L18 18 M18 6 L6 18" />
                        </Button>
                    </Grid>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource HairLine}"
                            Margin="0,16,0,0" />

                    <!-- Payment + checkout pinned to the bottom -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource HairLine}"
                            BorderThickness="0,1,0,0" Padding="22,16"
                            IsVisible="{Binding !IsCartEmpty}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Classes="fieldLabel" Text="PAYMENT METHOD" />
                                    <ComboBox Classes="field" ItemsSource="{Binding PaymentMethods}"
                                              SelectedItem="{Binding PaymentMethod}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Classes="fieldLabel" Text="AMOUNT PAID" />
                                    <TextBox Classes="field" Text="{Binding AmountPaidText}"
                                             PlaceholderText="exact" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Total" FontSize="14"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CartTotalLabel}" FontSize="20"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                            <TextBlock Text="{Binding ChangeLabel}" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Foreground="{StaticResource Accent}" />
                            <Button Classes="primary" CornerRadius="0" HorizontalAlignment="Stretch"
                                    Padding="12,13" Command="{Binding GoToCheckoutCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <TextBlock Text="Checkout" FontWeight="Bold" />
                                    <TextBlock Text="{Binding CartTotalLabel}" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost" HorizontalAlignment="Stretch"
                                    Command="{Binding NewSaleCommand}" Content="Clear Cart" />
                        </StackPanel>
                    </Border>

                    <!-- Cart lines -->
                    <Grid Margin="22,16,22,0">
                        <!-- Empty state -->
                        <StackPanel IsVisible="{Binding IsCartEmpty}" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Spacing="12">
                            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource ChipBg}">
                                <Path Classes="icon" Width="24" Height="24"
                                      Data="M3 4 H5 L7.2 15 H18 L20 7 H6 M8.5 19 a1.2 1.2 0 1 0 0.01 0 M17 19 a1.2 1.2 0 1 0 0.01 0" />
                            </Border>
                            <TextBlock Text="Your cart is empty" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="Pick a category, then add items to start a sale."
                                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding !IsCartEmpty}">
                            <ItemsControl ItemsSource="{Binding Cart}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CartLine">
                                        <Border CornerRadius="0" BorderBrush="{StaticResource HairLine}"
                                                BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Material}" FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding DimensionDisplay}" FontSize="12"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="bare" Width="26" Height="26"
                                                            VerticalAlignment="Top"
                                                            Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).RemoveLineCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Path Classes="icon" Width="15" Height="15"
                                                              Stroke="{StaticResource Danger}"
                                                              Data="M6 6 L18 18 M18 6 L6 18" />
                                                    </Button>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <!-- Quantity stepper -->
                                                    <Border Grid.Column="0" BorderThickness="1"
                                                            BorderBrush="{StaticResource Accent}"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Classes="qtyStep" Content="−"
                                                                    Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).DecrementLineCommand}"
                                                                    CommandParameter="{Binding}" />
                                                            <TextBlock Text="{Binding Quantity}" Classes="mono"
                                                                       Width="30" FontSize="13" FontWeight="Bold"
                                                                       TextAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextPrimary}" />
                                                            <Button Classes="qtyStep" Content="+"
                                                                    Command="{Binding $parent[ItemsControl].((vm:MaterialSelectionViewModel)DataContext).IncrementLineCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Editable unit price -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="@ $" VerticalAlignment="Center" FontSize="13"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                        <TextBox Classes="field" Width="74" Padding="6,6"
                                                                 Text="{Binding UnitPrice}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding LineTotalLabel}"
                                                               FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextPrimary}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Panel>
    </Grid>

</Window>
